"library(ggplot2)\n\nresults <- data.frame(b = c(0, 1.5, 3), mse = c(9, 2.25, 0))\n\nmanuscript_caption <- \"Three recorded corrections evaluated on the same five synthetic observations used to determine the correction. No stochastic repetitions or held-out evaluation.\"\n\nfig_intercept_error <- ggplot(results, aes(x = b, y = mse)) +\n  geom_point(\n    shape = 21,\n    size = 4.2,\n    stroke = 0.6,\n    fill = \"#0072B2\",\n    colour = \"#004A73\",\n    alpha = 1\n  ) +\n  annotate(\n    \"text\",\n    x = c(0, 1.5, 3),\n    y = c(9.45, 2.70, 0.45),\n    label = c(\"(0, 9)\", \"(1.5, 2.25)\", \"(3, 0)\"),\n    hjust = 0.5,\n    vjust = 0,\n    size = 12 * 25.4 / 72.27,\n    family = \"sans\",\n    fontface = \"plain\",\n    colour = \"#1F2937\"\n  ) +\n  scale_x_continuous(\n    breaks = c(0, 1.5, 3),\n    labels = c(\"0\", \"1.5\", \"3\"),\n    expand = c(0, 0)\n  ) +\n  scale_y_continuous(\n    breaks = c(0, 2.25, 4.5, 6.75, 9),\n    labels = c(\"0\", \"2.25\", \"4.5\", \"6.75\", \"9\"),\n    expand = c(0, 0)\n  ) +\n  coord_cartesian(\n    xlim = c(-0.35, 3.35),\n    ylim = c(-0.6, 10.2),\n    expand = FALSE\n  ) +\n  labs(\n    title = paste(\n      \"Recorded Mean Squared Error\",\n      \"at Three Intercept Corrections\",\n      sep = \"\\n\"\n    ),\n    x = \"Added intercept correction b\",\n    y = \"Mean squared error\"\n  ) +\n  theme_classic(base_size = 11, base_family = \"sans\") +\n  theme(\n    plot.background = element_rect(fill = \"white\", colour = NA),\n    panel.background = element_rect(fill = \"white\", colour = NA),\n    panel.border = element_blank(),\n    panel.ontop = FALSE,\n    panel.grid.major.x = element_blank(),\n    panel.grid.major.y = element_line(\n      colour = \"#E5E7EB\",\n      linewidth = 0.3\n    ),\n    panel.grid.minor = element_blank(),\n    axis.line = element_blank(),\n    axis.line.x.bottom = element_line(\n      colour = \"#6B7280\",\n      linewidth = 0.4\n    ),\n    axis.line.y.left = element_line(\n      colour = \"#6B7280\",\n      linewidth = 0.4\n    ),\n    axis.line.x.top = element_blank(),\n    axis.line.y.right = element_blank(),\n    axis.ticks = element_line(\n      colour = \"#6B7280\",\n      linewidth = 0.35\n    ),\n    axis.ticks.length = ggplot2::unit(3, \"pt\"),\n    axis.text = element_text(\n      size = 11,\n      face = \"plain\",\n      colour = \"#222222\",\n      angle = 0\n    ),\n    axis.title = element_text(\n      size = 13,\n      face = \"plain\",\n      colour = \"#222222\"\n    ),\n    axis.title.x = element_text(margin = margin(t = 10, unit = \"pt\")),\n    axis.title.y = element_text(margin = margin(r = 10, unit = \"pt\")),\n    plot.title.position = \"panel\",\n    plot.title = element_text(\n      family = \"sans\",\n      size = 16,\n      face = \"bold\",\n      colour = \"#111827\",\n      hjust = 0,\n      margin = margin(b = 12, unit = \"pt\")\n    ),\n    plot.margin = margin(t = 18, r = 24, b = 16, l = 18, unit = \"pt\"),\n    legend.position = \"none\"\n  )\n\np <- fig_intercept_error"