"library(ggplot2)\n\nfig_intercept_error <- data.frame(\n  b = c(0, 1.5, 3),\n  mse = c(9, 2.25, 0)\n)\n\nmanuscript_caption <- \"Three recorded corrections evaluated on the same five synthetic observations used to determine the correction. No stochastic repetitions or held-out evaluation.\"\n\n# The export device should map the built-in sans family to DejaVu Sans.\np <- ggplot(fig_intercept_error, aes(x = b, y = mse)) +\n  geom_point(\n    shape = 21,\n    size = 4.2,\n    stroke = 0.6,\n    fill = \"#0072B2\",\n    colour = \"#004A73\",\n    alpha = 1\n  ) +\n  annotate(\n    \"text\",\n    x = c(0, 1.5, 3),\n    y = c(9.45, 2.70, 0.45),\n    label = c(\"(0, 9)\", \"(1.5, 2.25)\", \"(3, 0)\"),\n    hjust = 0.5,\n    vjust = 0,\n    family = \"sans\",\n    fontface = \"plain\",\n    size = 12 / ggplot2::.pt,\n    colour = \"#1F2937\"\n  ) +\n  scale_x_continuous(\n    breaks = c(0, 1.5, 3),\n    labels = c(\"0\", \"1.5\", \"3\"),\n    expand = expansion(mult = 0, add = 0)\n  ) +\n  scale_y_continuous(\n    breaks = c(0, 2.25, 4.5, 6.75, 9),\n    labels = c(\"0\", \"2.25\", \"4.5\", \"6.75\", \"9\"),\n    expand = expansion(mult = 0, add = 0)\n  ) +\n  coord_cartesian(\n    xlim = c(-0.35, 3.35),\n    ylim = c(-0.6, 10.2),\n    expand = FALSE,\n    clip = \"on\"\n  ) +\n  labs(\n    title = \"Recorded Mean Squared Error\\nat Three Intercept Corrections\",\n    x = \"Added intercept correction b\",\n    y = \"Mean squared error\"\n  ) +\n  theme_classic(base_size = 11, base_family = \"sans\") +\n  theme(\n    plot.background = element_rect(fill = \"white\", colour = NA),\n    panel.background = element_rect(fill = \"white\", colour = NA),\n    plot.margin = margin(t = 18, r = 24, b = 16, l = 18, unit = \"pt\"),\n    plot.title.position = \"panel\",\n    plot.title = element_text(\n      size = 16,\n      face = \"bold\",\n      colour = \"#111827\",\n      hjust = 0,\n      margin = margin(b = 12, unit = \"pt\")\n    ),\n    axis.title = element_text(\n      size = 13,\n      face = \"plain\",\n      colour = \"#222222\"\n    ),\n    axis.title.x = element_text(margin = margin(t = 10, unit = \"pt\")),\n    axis.title.y = element_text(margin = margin(r = 10, unit = \"pt\")),\n    axis.text = element_text(\n      size = 11,\n      face = \"plain\",\n      colour = \"#222222\",\n      angle = 0\n    ),\n    axis.line = element_blank(),\n    axis.line.x.bottom = element_line(colour = \"#6B7280\", linewidth = 0.4),\n    axis.line.y.left = element_line(colour = \"#6B7280\", linewidth = 0.4),\n    axis.ticks = element_line(colour = \"#6B7280\", linewidth = 0.35),\n    axis.ticks.length = grid::unit(3, \"pt\"),\n    panel.border = element_blank(),\n    panel.grid.major.x = element_blank(),\n    panel.grid.major.y = element_line(colour = \"#E5E7EB\", linewidth = 0.3),\n    panel.grid.minor = element_blank(),\n    panel.ontop = FALSE,\n    legend.position = \"none\"\n  )\n\np"