"\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usetikzlibrary{arrows.meta,calc}\n\n\\definecolor{ink}{HTML}{1F2937}\n\\definecolor{slate}{HTML}{334155}\n\\definecolor{inputfill}{HTML}{EAF3FB}\n\\definecolor{inputedge}{HTML}{829DB4}\n\\definecolor{baselinefill}{HTML}{EEF2F6}\n\\definecolor{baselineedge}{HTML}{8795A5}\n\\definecolor{residualfill}{HTML}{FFF3DA}\n\\definecolor{residualedge}{HTML}{B49B63}\n\\definecolor{correctionfill}{HTML}{E7F3EF}\n\\definecolor{correctionedge}{HTML}{6B9D92}\n\\definecolor{correctionarrow}{HTML}{227C70}\n\\definecolor{evaluationfill}{HTML}{F1EFF6}\n\\definecolor{evaluationedge}{HTML}{9892A5}\n\n\\newcommand{\\heading}[1]{%\n  {\\sffamily\\fontsize{9.5}{11}\\selectfont\\bfseries #1}%\n}\n\\newcommand{\\labelfont}{\\sffamily\\fontsize{9}{10.5}\\selectfont}\n\n\\newsavebox{\\InputMath}\n\\newsavebox{\\TargetMath}\n\\newsavebox{\\BaselineMath}\n\\newsavebox{\\ResidualMath}\n\\newsavebox{\\MeanMath}\n\\newsavebox{\\CorrectedMath}\n\\newsavebox{\\ComparisonMath}\n\\newsavebox{\\EvaluationMath}\n\n\\newsavebox{\\InputBody}\n\\newsavebox{\\TargetBody}\n\\newsavebox{\\BaselineBody}\n\\newsavebox{\\ResidualBody}\n\\newsavebox{\\MeanBody}\n\\newsavebox{\\CorrectedBody}\n\\newsavebox{\\EvaluationBody}\n\\newsavebox{\\AverageLabel}\n\n\\newlength{\\ColumnA}\n\\newlength{\\ColumnB}\n\\newlength{\\ColumnC}\n\\newlength{\\ColumnD}\n\\newlength{\\AverageGap}\n\\newlength{\\SmallGap}\n\\newlength{\\DiagramWidth}\n\\newlength{\\RequiredWidth}\n\\newlength{\\UpperHeight}\n\\newlength{\\LowerHeight}\n\\newlength{\\TemporaryHeight}\n\\newlength{\\RowSeparation}\n\\newlength{\\ChannelY}\n\\newlength{\\XA}\n\\newlength{\\XB}\n\\newlength{\\XC}\n\\newlength{\\XD}\n\n% Measure complete typeset blocks, including aligned continuation lines.\n% The additional 5.2 mm supplies 2.6 mm horizontal padding on each side.\n\\newcommand{\\columnwidth}[3]{%\n  \\setlength{#1}{\\wd#2}%\n  \\ifdim\\wd#3>#1\n    \\setlength{#1}{\\wd#3}%\n  \\fi\n  \\addtolength{#1}{5.2mm}%\n}\n\\newcommand{\\includeheight}[2]{%\n  \\setlength{\\TemporaryHeight}{%\n    \\dimexpr\\ht#2+\\dp#2+4.8mm\\relax}%\n  \\ifdim\\TemporaryHeight>#1\n    \\setlength{#1}{\\TemporaryHeight}%\n  \\fi\n}\n\n\\begin{document}\n\\color{ink}\n\\sffamily\n\\fontsize{10}{12}\\selectfont\n\n\\sbox{\\InputMath}{%\n  $\\displaystyle \\mathbf{x}=(-2,-1,0,1,2)$}\n\n\\sbox{\\TargetMath}{%\n  $\\displaystyle\n  \\begin{gathered}\n    \\mathbf{y}=2\\mathbf{x}+3\\cdot\\mathbf{1}_5\\\\[0.6mm]\n    \\mathbf{y}=(-1,1,3,5,7)\\\\[0.8mm]\n    \\textstyle\\mathbf{1}_5=(1,1,1,1,1)\n  \\end{gathered}$}\n\n\\sbox{\\BaselineMath}{%\n  $\\displaystyle\n  \\begin{aligned}\n    \\widehat{\\mathbf{y}}^{(0)}&=2\\mathbf{x}\\\\[0.6mm]\n                            &=(-4,-2,0,2,4)\n  \\end{aligned}$}\n\n\\sbox{\\ResidualMath}{%\n  $\\displaystyle\n  \\begin{gathered}\n    \\mathbf{r}=\\mathbf{y}-2\\mathbf{x}\\\\[0.6mm]\n    \\mathbf{r}=(3,3,3,3,3)\n  \\end{gathered}$}\n\n\\sbox{\\MeanMath}{%\n  $\\displaystyle b=\\frac{1}{5}\\sum_{i=1}^{5}r_i=3$}\n\n\\sbox{\\CorrectedMath}{%\n  $\\displaystyle\n  \\begin{aligned}\n    \\widehat{\\mathbf{y}}^{\\,\\mathrm{corr}}\n      &=2\\mathbf{x}+b\\cdot\\mathbf{1}_5\\\\[0.6mm]\n    \\widehat{\\mathbf{y}}^{\\,\\mathrm{corr}}\n      &=(-1,1,3,5,7)\n  \\end{aligned}$}\n\n\\sbox{\\ComparisonMath}{%\n  $\\displaystyle\n    \\mathbf{y}\\quad\\text{vs.}\\quad\n    \\widehat{\\mathbf{y}}^{\\,\\mathrm{corr}}$}\n\n\\sbox{\\EvaluationMath}{%\n  $\\displaystyle\n  \\begin{aligned}\n    \\mathrm{MSE}\n      &=\\frac{1}{5}\\sum_{i=1}^{5}\n        \\left(y_i-\\widehat y_i^{\\,\\mathrm{corr}}\\right)^2\\\\[0.5mm]\n      &=0\n  \\end{aligned}$}\n\n\\sbox{\\InputBody}{%\n  \\begin{tabular}{@{}c@{}}\n    \\heading{Input observations}\\\\[1.2mm]\n    \\usebox{\\InputMath}\n  \\end{tabular}}\n\n\\sbox{\\TargetBody}{%\n  \\begin{tabular}{@{}c@{}}\n    \\heading{Observed targets}\\\\[1.2mm]\n    \\usebox{\\TargetMath}\n  \\end{tabular}}\n\n\\sbox{\\BaselineBody}{%\n  \\begin{tabular}{@{}c@{}}\n    \\heading{Fixed baseline}\\\\[1.2mm]\n    \\usebox{\\BaselineMath}\n  \\end{tabular}}\n\n\\sbox{\\ResidualBody}{%\n  \\begin{tabular}{@{}c@{}}\n    \\heading{Observed residuals}\\\\[1.2mm]\n    \\usebox{\\ResidualMath}\n  \\end{tabular}}\n\n\\sbox{\\MeanBody}{%\n  \\begin{tabular}{@{}c@{}}\n    \\heading{Mean residual}\\\\[1.2mm]\n    \\usebox{\\MeanMath}\n  \\end{tabular}}\n\n\\sbox{\\CorrectedBody}{%\n  \\begin{tabular}{@{}c@{}}\n    \\heading{Corrected prediction}\\\\[1.2mm]\n    \\usebox{\\CorrectedMath}\n  \\end{tabular}}\n\n\\sbox{\\EvaluationBody}{%\n  \\begin{tabular}{@{}c@{}}\n    \\heading{Evaluate on the same}\\\\[-0.3mm]\n    \\heading{five observations}\\\\[1.2mm]\n    \\usebox{\\ComparisonMath}\\\\[1.1mm]\n    \\usebox{\\EvaluationMath}\n  \\end{tabular}}\n\n\\sbox{\\AverageLabel}{%\n  \\labelfont\n  \\begin{tabular}{@{}c@{}}\n    average\\\\[-0.3mm]\n    residuals\n  \\end{tabular}}\n\n\\columnwidth{\\ColumnA}{\\InputBody}{\\TargetBody}\n\\columnwidth{\\ColumnB}{\\BaselineBody}{\\ResidualBody}\n\\columnwidth{\\ColumnC}{\\MeanBody}{\\MeanBody}\n\\columnwidth{\\ColumnD}{\\CorrectedBody}{\\EvaluationBody}\n\n% Reserve measured label width plus clearance from both neighboring nodes.\n\\setlength{\\AverageGap}{\\dimexpr\\wd\\AverageLabel+3.4mm\\relax}\n\n% Approximately 18 cm overall, including the standalone border.\n% Expand only if the measured mathematics requires additional room.\n\\setlength{\\DiagramWidth}{\\dimexpr18cm-10pt\\relax}\n\\setlength{\\RequiredWidth}{%\n  \\dimexpr\\ColumnA+\\ColumnB+\\ColumnC+\\ColumnD\n  +\\AverageGap+11mm\\relax}\n\\ifdim\\RequiredWidth>\\DiagramWidth\n  \\setlength{\\DiagramWidth}{\\RequiredWidth}\n\\fi\n\\setlength{\\SmallGap}{%\n  \\dimexpr\\DiagramWidth-\\ColumnA-\\ColumnB-\\ColumnC-\\ColumnD\n  -\\AverageGap\\relax}\n\\divide\\SmallGap by 2\n\n\\setlength{\\XA}{\\dimexpr\\ColumnA/2\\relax}\n\\setlength{\\XB}{%\n  \\dimexpr\\ColumnA+\\SmallGap+\\ColumnB/2\\relax}\n\\setlength{\\XC}{%\n  \\dimexpr\\ColumnA+\\SmallGap+\\ColumnB+\\AverageGap\n  +\\ColumnC/2\\relax}\n\\setlength{\\XD}{\\dimexpr\\DiagramWidth-\\ColumnD/2\\relax}\n\n\\setlength{\\UpperHeight}{0pt}\n\\includeheight{\\UpperHeight}{\\InputBody}\n\\includeheight{\\UpperHeight}{\\BaselineBody}\n\\includeheight{\\UpperHeight}{\\CorrectedBody}\n\n\\setlength{\\LowerHeight}{0pt}\n\\includeheight{\\LowerHeight}{\\TargetBody}\n\\includeheight{\\LowerHeight}{\\ResidualBody}\n\\includeheight{\\LowerHeight}{\\MeanBody}\n\\includeheight{\\LowerHeight}{\\EvaluationBody}\n\n% Keep the closest upper/lower boundaries clearly separated.\n\\setlength{\\RowSeparation}{%\n  \\dimexpr\\UpperHeight/2+\\LowerHeight/2+5.5mm\\relax}\n\\setlength{\\ChannelY}{%\n  \\dimexpr-\\RowSeparation-\\LowerHeight/2-5.8mm\\relax}\n\n\\begin{tikzpicture}[\n  panel/.style={\n    rectangle,\n    rounded corners=2mm,\n    line width=0.7pt,\n    inner xsep=2.6mm,\n    inner ysep=2.4mm,\n    outer sep=0.35pt,\n    align=center,\n    text=ink\n  },\n  supplied/.style={\n    panel,fill=inputfill,draw=inputedge\n  },\n  fixed/.style={\n    panel,fill=baselinefill,draw=baselineedge\n  },\n  residual/.style={\n    panel,fill=residualfill,draw=residualedge\n  },\n  corrected/.style={\n    panel,fill=correctionfill,draw=correctionedge\n  },\n  evaluation/.style={\n    panel,fill=evaluationfill,draw=evaluationedge\n  },\n  dependency/.style={\n    line width=0.9pt,\n    -{Latex[length=1.9mm,width=1.25mm]},\n    shorten <=0.35pt,\n    shorten >=0.35pt,\n    line cap=round,\n    line join=round\n  },\n  slate arrow/.style={dependency,draw=slate},\n  teal arrow/.style={dependency,draw=correctionarrow},\n  edge label/.style={\n    font=\\labelfont,\n    text=ink,\n    fill=white,\n    inner xsep=0.6mm,\n    inner ysep=0.25mm,\n    outer sep=0pt,\n    align=center\n  }\n]\n\n\\node[supplied,minimum width=\\ColumnA]\n  (input) at (\\XA,0) {\\usebox{\\InputBody}};\n\n\\node[supplied,minimum width=\\ColumnA]\n  (targets) at (\\XA,-\\RowSeparation) {\\usebox{\\TargetBody}};\n\n\\node[fixed,minimum width=\\ColumnB]\n  (baseline) at (\\XB,0) {\\usebox{\\BaselineBody}};\n\n\\node[residual,minimum width=\\ColumnB]\n  (residuals) at (\\XB,-\\RowSeparation) {\\usebox{\\ResidualBody}};\n\n\\node[corrected,minimum width=\\ColumnC]\n  (mean) at (\\XC,-\\RowSeparation) {\\usebox{\\MeanBody}};\n\n\\node[corrected,minimum width=\\ColumnD]\n  (prediction) at (\\XD,0) {\\usebox{\\CorrectedBody}};\n\n\\node[evaluation,minimum width=\\ColumnD]\n  (evaluate) at (\\XD,-\\RowSeparation) {\\usebox{\\EvaluationBody}};\n\n% 1. Supplied inputs to the fixed baseline.\n\\draw[slate arrow]\n  (input.east) -- (baseline.west);\n\n% 2. Fixed baseline to observed residuals.\n\\draw[slate arrow]\n  (baseline.south) -- (residuals.north);\n\n% 3. Supplied targets to observed residuals.\n\\draw[slate arrow]\n  (targets.east) -- (residuals.west);\n\n% 4. Residuals to their scalar mean.\n\\draw[teal arrow]\n  (residuals.east) --\n  node[edge label,above=1.5mm] {\\usebox{\\AverageLabel}}\n  (mean.west);\n\n% 5. Baseline contribution across the open upper third column.\n\\draw[slate arrow]\n  (baseline.east) --\n  node[edge label,above=1.5mm] {$2\\mathbf{x}$}\n  (prediction.west);\n\n% 6. Separate correction contribution, below the baseline dependency.\n\\coordinate (correction-port) at ([yshift=-5mm]prediction.west);\n\\coordinate (correction-elbow) at (mean.north |- correction-port);\n\\draw[teal arrow,rounded corners=1.1mm]\n  (mean.north) -- (correction-elbow) --\n  node[edge label,below=1.5mm] {$b=3$}\n  (correction-port);\n\n% 7. Corrected predictions to evaluation.\n\\draw[slate arrow]\n  (prediction.south) -- (evaluate.north);\n\n% 8. Independent target-data route beneath every lower-row node.\n\\coordinate (channel-level) at (0,\\ChannelY);\n\\draw[slate arrow,rounded corners=1.1mm]\n  (targets.south) --\n  (targets.south |- channel-level) --\n  node[edge label,below=1.5mm] (target-route-label)\n    {observed targets: same five points}\n  (evaluate.south |- channel-level) --\n  (evaluate.south);\n\n\\coordinate (diagram-center) at\n  (\\dimexpr\\DiagramWidth/2\\relax,0);\n\\node[\n  anchor=north,\n  inner sep=0pt,\n  outer sep=0pt,\n  font=\\sffamily\\fontsize{9}{11}\\selectfont,\n  text=ink,\n  align=center\n] at\n  ($ (diagram-center |- target-route-label.south)+(0,-2mm) $)\n  {The correction is computed and evaluated on these same five observations.};\n\n\\end{tikzpicture}\n\\end{document}"