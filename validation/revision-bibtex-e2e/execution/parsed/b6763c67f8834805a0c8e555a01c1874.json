"\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usetikzlibrary{arrows.meta,positioning,calc}\n\n\\definecolor{obsfill}{HTML}{DDEBF7}\n\\definecolor{obsline}{HTML}{2F5597}\n\\definecolor{basefill}{HTML}{EFEFEF}\n\\definecolor{baseline}{HTML}{595959}\n\\definecolor{resfill}{HTML}{FBE5D6}\n\\definecolor{resline}{HTML}{C55A11}\n\\definecolor{predfill}{HTML}{E2F0D9}\n\\definecolor{predline}{HTML}{548235}\n\\definecolor{evalline}{HTML}{404040}\n\\definecolor{arrowgray}{HTML}{333333}\n\n\\newcommand{\\mathline}[1]{%\n  {\\fontsize{10}{12}\\selectfont\\ensuremath{#1}}%\n}\n\n\\begin{document}\n\\begin{tikzpicture}[\n  font=\\fontsize{9}{11}\\selectfont,\n  box/.style={\n    rectangle,\n    rounded corners=3pt,\n    line width=0.6pt,\n    align=center,\n    inner xsep=6pt,\n    inner ysep=7pt,\n    outer sep=0pt\n  },\n  observation/.style={box,fill=obsfill,draw=obsline},\n  baselinebox/.style={box,fill=basefill,draw=baseline},\n  residualbox/.style={box,fill=resfill,draw=resline},\n  prediction/.style={box,fill=predfill,draw=predline},\n  evaluation/.style={box,fill=white,draw=evalline},\n  computation/.style={\n    draw=arrowgray,\n    line width=0.8pt,\n    -{Stealth[length=5pt,width=4pt]},\n    rounded corners=2pt\n  },\n  reuse/.style={\n    draw=obsline,\n    line width=0.6pt,\n    dash pattern=on 3pt off 2pt,\n    -{Stealth[length=5pt,width=4pt]},\n    rounded corners=3pt\n  },\n  arrowlabel/.style={\n    font=\\fontsize{10}{12}\\selectfont,\n    fill=white,\n    inner sep=1.5pt,\n    text=arrowgray\n  }\n]\n\n% Explicit landscape canvas: 19.5 cm by 10.96875 cm (16:9).\n\\path[use as bounding box]\n  (-0.2,-4.55) rectangle (19.3,6.41875);\n\\fill[white]\n  (-0.2,-4.55) rectangle (19.3,6.41875);\n\n% Column 1.\n\\node[\n  observation,\n  minimum width=3cm,\n  minimum height=3.8cm,\n  text width=2.55cm\n] (observations) at (1.5,1.1) {%\n  \\mbox{Observations ($n=5$)}\\\\[9pt]\n  \\renewcommand{\\arraystretch}{1.18}%\n  \\begin{tabular}{@{}r@{\\qquad}r@{}}\n    $x$ & $y=2x+3$\\\\[2pt]\n    \\hline\n    \\rule{0pt}{13pt}$-2$ & $-1$\\\\\n    $-1$ & $1$\\\\\n    $0$  & $3$\\\\\n    $1$  & $5$\\\\\n    $2$  & $7$\n  \\end{tabular}\n};\n\n% Column 2, lower row.\n\\node[\n  residualbox,\n  minimum width=2.8cm,\n  minimum height=1.8cm,\n  text width=2.35cm\n] (residuals) at (5.2,0.2) {%\n  Residuals\\\\[4pt]\n  \\mathline{r_i=y_i-2x_i}\\\\[5pt]\n  $r_i=3,\\,3,\\,3,\\,3,\\,3$\\\\[2pt]\n  {\\fontsize{8}{10}\\selectfont $(i=1,\\dots,5)$}\n};\n\n% Column 2, upper row.\n\\node[\n  baselinebox,\n  above=0.8cm of residuals,\n  minimum width=2.8cm,\n  minimum height=1.15cm,\n  text width=2.35cm\n] (fixed) {%\n  Fixed baseline\\\\[5pt]\n  \\mathline{\\hat{y}^{(0)}=2x}\n};\n\n% Column 3.\n\\node[\n  residualbox,\n  right=1cm of residuals,\n  minimum width=2.4cm,\n  minimum height=1.4cm,\n  text width=1.95cm\n] (correction) {%\n  \\mathline{\\displaystyle b=\\frac{1}{5}\\sum_{i=1}^{5}r_i=3}\n};\n\n% Column 4.\n\\node[\n  prediction,\n  right=1cm of correction,\n  minimum width=3cm,\n  minimum height=1.6cm,\n  text width=2.55cm\n] (corrected) {%\n  \\mbox{Corrected prediction}\\\\[6pt]\n  \\mathline{\\hat{y}_i=2x_i+b}\n};\n\n% Column 5.\n\\node[\n  evaluation,\n  right=1cm of corrected,\n  minimum width=4.1cm,\n  minimum height=2.3cm,\n  text width=3.66cm,\n  inner xsep=6pt\n] (evaluation) {%\n  Evaluation on the same\\\\\n  5 observations\\\\[8pt]\n  \\mathline{e_i=\\hat{y}_i-y_i=0}\\\\[8pt]\n  {\\fontsize{8}{10}\\selectfont\n   finite arithmetic check,\\\\\n   not generalization}\n};\n\n% Observation-to-baseline step, kept above the observation-to-residual arrow.\n\\coordinate (xstart) at (observations.east |- fixed.south);\n\\coordinate (xstep) at ($(xstart)+(0.4,0)$);\n\\draw[computation]\n  (xstart) -- (xstep) |- (fixed.west)\n  node[pos=0.80,above=3pt,arrowlabel] {$x$};\n\n% Observed responses and baseline predictions produce the residuals.\n\\draw[computation]\n  (observations.east |- residuals.west)\n  -- node[above=4pt,arrowlabel] {$y_i$}\n  (residuals.west);\n\n\\draw[computation]\n  (fixed.south)\n  -- node[right=4pt,arrowlabel] {$2x_i$}\n  (residuals.north);\n\n% Residuals determine the scalar correction.\n\\draw[computation] (residuals.east) -- (correction.west);\n\n\\coordinate (dependency) at\n  ($(residuals.east)!0.5!(correction.west)$);\n\\node[\n  below=1.4cm of dependency,\n  anchor=north,\n  align=center,\n  inner sep=0pt,\n  font=\\fontsize{8}{10}\\selectfont\\itshape\n] {%\n  \\mbox{data dependency: correction computed}\\\\\n  \\mbox{from observed residuals}\n};\n\n% Baseline bypass, in its own upper corridor.\n\\coordinate (bypassleft) at ($(fixed.north)+(0,1.2)$);\n\\coordinate (bypassright) at (corrected.north |- bypassleft);\n\\draw[computation]\n  (fixed.north)\n  -- (bypassleft)\n  -- node[midway,above=4pt,arrowlabel] {$2x_i$}\n     (bypassright)\n  -- (corrected.north);\n\n\\draw[computation]\n  (correction.east)\n  -- node[above=4pt,arrowlabel] {$+b$}\n  (corrected.west);\n\n\\draw[computation]\n  (corrected.east)\n  -- node[above=4pt,arrowlabel] {$\\hat{y}_i$}\n  (evaluation.west);\n\n% Reuse of the observations, below every block and annotation.\n\\coordinate (reuseleft) at (observations.south |- 0,-2.6);\n\\coordinate (reuseright) at (evaluation.south |- 0,-2.6);\n\\draw[reuse]\n  (observations.south)\n  -- (reuseleft)\n  -- node[\n       midway,\n       above=4pt,\n       fill=white,\n       inner sep=2pt,\n       text=obsline,\n       font=\\fontsize{8}{10}\\selectfont\n     ] {same observations $(x_i,y_i)$ reused}\n     (reuseright)\n  -- (evaluation.south);\n\n\\end{tikzpicture}\n\\end{document}"