"\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usetikzlibrary{arrows.meta,positioning,calc}\n\n\\definecolor{obsfill}{HTML}{DDEBF7}\n\\definecolor{obsline}{HTML}{2F5597}\n\\definecolor{basefill}{HTML}{EFEFEF}\n\\definecolor{baseline}{HTML}{595959}\n\\definecolor{resfill}{HTML}{FBE5D6}\n\\definecolor{resline}{HTML}{C55A11}\n\\definecolor{predfill}{HTML}{E2F0D9}\n\\definecolor{predline}{HTML}{548235}\n\\definecolor{evalline}{HTML}{404040}\n\\definecolor{arrowline}{HTML}{333333}\n\n\\begin{document}\n\\begin{tikzpicture}[\n    font=\\fontsize{9}{11}\\selectfont,\n    block/.style={\n        rectangle,\n        rounded corners=3pt,\n        line width=0.6pt,\n        align=center,\n        inner sep=5pt,\n        outer sep=0pt\n    },\n    observation/.style={block,fill=obsfill,draw=obsline},\n    baselineblock/.style={block,fill=basefill,draw=baseline},\n    residualblock/.style={block,fill=resfill,draw=resline},\n    prediction/.style={block,fill=predfill,draw=predline},\n    evaluation/.style={block,fill=white,draw=evalline},\n    computation/.style={\n        draw=arrowline,\n        line width=0.8pt,\n        -{Stealth[length=4.5pt,width=3.5pt]}\n    },\n    reuse/.style={\n        draw=obsline,\n        line width=0.6pt,\n        dash pattern=on 3pt off 2pt,\n        -{Stealth[length=4.5pt,width=3.5pt]}\n    },\n    arrowlabel/.style={\n        font=\\fontsize{10}{12}\\selectfont,\n        fill=white,\n        inner sep=2pt\n    },\n    annotation/.style={\n        font=\\fontsize{8}{10}\\selectfont,\n        align=center,\n        inner sep=2pt\n    }\n]\n\n% A landscape drawing area with a 16:9 aspect ratio.\n\\path[use as bounding box]\n    (-1.70,-4.60) rectangle (16.60,5.69375);\n\n% Stage 1: observations.\n\\node[observation,minimum width=3cm,minimum height=3.35cm]\n    (observations) at (0,0) {%\n    \\begin{minipage}{2.58cm}\n        \\centering\n        Observations ($n=5$)\\\\[7pt]\n        \\renewcommand{\\arraystretch}{1.22}\n        \\setlength{\\tabcolsep}{7pt}\n        \\begin{tabular}{@{}r r@{}}\n            $x$ & $y=2x+3$\\\\[2pt]\n            \\hline\n            $-2$ & $-1$\\\\\n            $-1$ & $1$\\\\\n            $0$  & $3$\\\\\n            $1$  & $5$\\\\\n            $2$  & $7$\n        \\end{tabular}\n    \\end{minipage}\n};\n\n% Stage 2: residuals and the fixed baseline, sharing one column.\n\\node[residualblock,\n      minimum width=3cm,\n      minimum height=1.65cm,\n      right=0.8cm of observations]\n    (residuals) {%\n    \\begin{tabular}{@{}c@{}}\n        Residuals\\\\[4pt]\n        $\\displaystyle r_i=y_i-2x_i$\\\\[4pt]\n        $r_i=3,3,3,3,3$\\\\[2pt]\n        {\\fontsize{8}{10}\\selectfont $(i=1,\\dots,5)$}\n    \\end{tabular}\n};\n\n\\node[baselineblock,\n      minimum width=3cm,\n      minimum height=1.15cm,\n      above=1.05cm of residuals]\n    (fixedbaseline) {%\n    \\begin{tabular}{@{}c@{}}\n        Fixed baseline\\\\[5pt]\n        $\\displaystyle \\hat{y}^{(0)}=2x$\n    \\end{tabular}\n};\n\n% Stage 3: one scalar correction derived from the observed residuals.\n\\node[residualblock,\n      minimum width=2.6cm,\n      minimum height=1.15cm,\n      right=0.8cm of residuals]\n    (correction) {%\n    $\\displaystyle b=\\frac{1}{5}\\sum_{i=1}^{5}r_i=3$\n};\n\n% Stage 4: corrected prediction.\n\\node[prediction,\n      minimum width=2.9cm,\n      minimum height=1.30cm,\n      right=0.8cm of correction]\n    (corrected) {%\n    \\begin{tabular}{@{}c@{}}\n        Corrected prediction\\\\[6pt]\n        $\\displaystyle \\hat{y}_i=2x_i+b$\n    \\end{tabular}\n};\n\n% Stage 5: evaluation on the same observations.\n\\node[evaluation,\n      minimum width=3.2cm,\n      minimum height=2.15cm,\n      right=0.8cm of corrected]\n    (evaluate) {%\n    \\begin{tabular}{@{}c@{}}\n        Evaluation on the\\\\\n        same 5 observations\\\\[7pt]\n        $\\displaystyle e_i=\\hat{y}_i-y_i=0$\\\\[7pt]\n        {\\fontsize{8}{10}\\selectfont finite arithmetic check,}\\\\\n        {\\fontsize{8}{10}\\selectfont not generalization}\n    \\end{tabular}\n};\n\n% Observation outputs use distinct anchors and separate routing corridors.\n\\coordinate (xout) at ($(observations.east)+(0,0.95)$);\n\\coordinate (xturn) at ($(xout)+(0.36,0)$);\n\n\\draw[computation]\n    (xout) -- (xturn)\n    |- node[arrowlabel,pos=0.78,above] {$x$}\n    (fixedbaseline.west);\n\n\\draw[computation]\n    (observations.east)\n    -- node[arrowlabel,above] {$y_i$}\n    (residuals.west);\n\n% Baseline values enter the residual calculation vertically.\n\\draw[computation]\n    (fixedbaseline.south)\n    -- node[arrowlabel,right] {$2x_i$}\n    (residuals.north);\n\n% Residuals determine the correction.\n\\draw[computation]\n    (residuals.east) -- (correction.west);\n\n\\coordinate (dependencycenter)\n    at ($(residuals.east)!0.5!(correction.west)$);\n\\node[annotation,\n      font=\\fontsize{8}{10}\\selectfont\\itshape,\n      text width=5.2cm,\n      anchor=north]\n    at ($(dependencycenter)+(0,-1.22)$)\n    {data dependency: correction computed\\\\from observed residuals};\n\n% The fixed baseline is also carried directly to the final predictor.\n\\coordinate (baselineroute)\n    at ($(fixedbaseline.north)+(0,0.68)$);\n\\draw[computation]\n    (fixedbaseline.north)\n    -- (baselineroute)\n    -- node[arrowlabel,above] {$2x_i$}\n       (corrected.north |- baselineroute)\n    -- (corrected.north);\n\n\\draw[computation]\n    (correction.east)\n    -- node[arrowlabel,above] {$+b$}\n    (corrected.west);\n\n\\draw[computation]\n    (corrected.east) -- (evaluate.west);\n\n% Reuse is explicitly shown in a corridor below every block and annotation.\n\\coordinate (reuseleft) at ($(observations.south)+(0,-1.35)$);\n\\coordinate (reuseright) at (evaluate.south |- reuseleft);\n\\draw[reuse]\n    (observations.south)\n    -- (reuseleft)\n    -- node[annotation,text=obsline,fill=white,above=3pt]\n       {same observations reused}\n       (reuseright)\n    -- (evaluate.south);\n\n\\end{tikzpicture}\n\\end{document}"