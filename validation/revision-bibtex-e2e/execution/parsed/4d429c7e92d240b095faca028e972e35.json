"\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usetikzlibrary{arrows.meta,calc,positioning}\n\n\\definecolor{obsfill}{HTML}{DDEBF7}\n\\definecolor{obsline}{HTML}{2F5597}\n\\definecolor{basefill}{HTML}{EFEFEF}\n\\definecolor{baseline}{HTML}{595959}\n\\definecolor{resfill}{HTML}{FBE5D6}\n\\definecolor{resline}{HTML}{C55A11}\n\\definecolor{corrfill}{HTML}{E2F0D9}\n\\definecolor{corrline}{HTML}{548235}\n\\definecolor{evalline}{HTML}{404040}\n\\definecolor{flowline}{HTML}{333333}\n\n\\begin{document}\n\\begin{tikzpicture}[\n    font=\\fontsize{9}{11}\\selectfont,\n    box/.style={\n        rectangle,\n        rounded corners=3pt,\n        line width=0.6pt,\n        align=center,\n        inner sep=5pt,\n        outer sep=0pt\n    },\n    observed/.style={box,fill=obsfill,draw=obsline},\n    baselinebox/.style={box,fill=basefill,draw=baseline},\n    residualbox/.style={box,fill=resfill,draw=resline},\n    correctedbox/.style={box,fill=corrfill,draw=corrline},\n    evaluationbox/.style={box,fill=white,draw=evalline},\n    flow/.style={\n        draw=flowline,\n        line width=0.8pt,\n        -{Stealth[length=4.5pt,width=3.5pt]},\n        rounded corners=3pt\n    },\n    reuse/.style={\n        draw=obsline,\n        line width=0.6pt,\n        dash pattern=on 3pt off 2pt,\n        -{Stealth[length=4.5pt,width=3.5pt]},\n        rounded corners=4pt\n    },\n    arrowlabel/.style={\n        font=\\fontsize{9}{11}\\selectfont,\n        fill=white,\n        inner sep=2pt,\n        text=flowline\n    }\n]\n\n% White landscape canvas with a 16:9 drawing area.\n\\path[fill=white] (0,0) rectangle (14.4,8.1);\n\n% Observation table: column centers also define the outgoing data ports.\n\\node[observed,minimum width=2.15cm,minimum height=3.25cm]\n    (obs) at (1.10,4.10) {%\n    \\begin{tabular}{@{}c@{}}\n        Observations ($n=5$)\\\\[6pt]\n        \\begingroup\n        \\renewcommand{\\arraystretch}{1.2}\n        \\setlength{\\tabcolsep}{5pt}\n        \\begin{tabular}{@{}cc@{}}\n            \\hline\n            $x$ & $y=2x+3$\\\\\n            \\hline\n            $-2$ & $-1$\\\\\n            $-1$ & $1$\\\\\n            $0$  & $3$\\\\\n            $1$  & $5$\\\\\n            $2$  & $7$\\\\\n            \\hline\n        \\end{tabular}\n        \\endgroup\n    \\end{tabular}\n};\n\n\\node[baselinebox,minimum width=1.90cm,minimum height=1.10cm]\n    (base) at (3.50,5.70) {%\n    Fixed baseline\\\\[5pt]\n    {\\fontsize{10}{12}\\selectfont $\\hat{y}^{(0)}=2x$}\n};\n\n\\node[residualbox,minimum width=2.30cm,minimum height=1.45cm]\n    (resid) at (5.75,4.00) {%\n    Residuals\\\\[5pt]\n    {\\fontsize{10}{12}\\selectfont $r_i=y_i-2x_i$}\\\\[5pt]\n    $r_i=3,\\;3,\\;3,\\;3,\\;3$\\\\[2pt]\n    $i=1,\\dots,5$\n};\n\n\\node[residualbox,minimum width=2.05cm,minimum height=1.10cm]\n    (bval) at (8.20,4.00) {%\n    {\\fontsize{10}{12}\\selectfont\n        $\\displaystyle b=\\frac{1}{5}\\sum_{i=1}^{5}r_i=3$}\n};\n\n\\node[correctedbox,minimum width=2.25cm,minimum height=1.15cm]\n    (corr) at (10.55,5.70) {%\n    Corrected prediction\\\\[5pt]\n    {\\fontsize{10}{12}\\selectfont $\\hat{y}_i=2x_i+b$}\n};\n\n\\node[evaluationbox,text width=2.20cm,minimum height=2.05cm]\n    (eval) at (13.05,4.00) {%\n    Evaluation on the\\\\\n    same 5 observations\\\\[7pt]\n    {\\fontsize{10}{12}\\selectfont $e_i=\\hat{y}_i-y_i=0$}\\\\[7pt]\n    {\\fontsize{8}{10}\\selectfont\n        finite arithmetic check,\\\\\n        not generalization}\n};\n\n% x exits above its observation-table column.\n\\coordinate (obsx) at ($(obs.north)+(-0.48,0)$);\n\\draw[flow]\n    (obsx) -- (0.62,6.45)\n    -- node[arrowlabel,above] {$x$} (2.30,6.45)\n    -- (2.30,5.70) -- (base.west);\n\n% Observed y values feed residual computation.\n\\draw[flow]\n    (obs.east) -- (3.30,4.10)\n    -- (3.30,4.00)\n    -- node[arrowlabel,above] {$y_i$} (resid.west);\n\n% Baseline values feed residual computation.\n\\draw[flow]\n    (base.south) -- (3.50,4.95)\n    -- node[arrowlabel,above] {$2x_i$} (5.75,4.95)\n    -- (resid.north);\n\n% The baseline also feeds the corrected prediction along the upper route.\n\\draw[flow]\n    (base.north) -- (3.50,7.15)\n    -- node[arrowlabel,above] {$2x_i$} (10.55,7.15)\n    -- (corr.north);\n\n% The annotated dependency is given its own spacious lower route.\n\\draw[flow]\n    (resid.south) -- (5.75,2.70)\n    -- (8.20,2.70) -- (bval.south);\n\n\\node[\n    align=center,\n    text=flowline,\n    font=\\fontsize{9}{11}\\selectfont\\itshape,\n    anchor=north,\n    inner sep=2pt\n] at (6.975,2.58) {%\n    data dependency: correction\\\\\n    computed from observed residuals\n};\n\n% Add the fitted scalar correction.\n\\draw[flow]\n    (bval.east)\n    -- node[arrowlabel,above] {$+\\,b$} (10.55,4.00)\n    -- (corr.south);\n\n% Corrected values enter the arithmetic evaluation.\n\\draw[flow]\n    (corr.east) -- (13.05,5.70) -- (eval.north);\n\n% Reuse of the same observations is visually distinct from computation.\n\\draw[reuse]\n    (obs.south) -- (1.10,1.05)\n    -- node[\n        midway,\n        fill=white,\n        inner sep=3pt,\n        text=obsline,\n        font=\\fontsize{8.5}{10}\\selectfont\n    ] {same observations reused}\n    (13.05,1.05) -- (eval.south);\n\n\\end{tikzpicture}\n\\end{document}"