"\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usetikzlibrary{arrows.meta,positioning,calc}\n\n\\definecolor{obsfill}{HTML}{DDEBF7}\n\\definecolor{obsborder}{HTML}{2F5597}\n\\definecolor{basefill}{HTML}{EFEFEF}\n\\definecolor{baseborder}{HTML}{595959}\n\\definecolor{resfill}{HTML}{FBE5D6}\n\\definecolor{resborder}{HTML}{C55A11}\n\\definecolor{predfill}{HTML}{E2F0D9}\n\\definecolor{predborder}{HTML}{548235}\n\\definecolor{evalborder}{HTML}{404040}\n\\definecolor{arrowgray}{HTML}{333333}\n\n\\begin{document}\n\\begin{tikzpicture}[\n  font=\\fontsize{9}{11}\\selectfont,\n  box/.style={\n    rectangle,\n    rounded corners=3pt,\n    line width=0.6pt,\n    align=center,\n    inner xsep=4pt,\n    inner ysep=7pt,\n    outer sep=0pt\n  },\n  observation/.style={\n    box,draw=obsborder,fill=obsfill,\n    minimum width=3cm,text width=2.65cm,\n    minimum height=3.3cm\n  },\n  baseline/.style={\n    box,draw=baseborder,fill=basefill,\n    minimum width=3cm,text width=2.65cm,\n    minimum height=1.3cm\n  },\n  residual/.style={\n    box,draw=resborder,fill=resfill,\n    minimum width=3cm,text width=2.7cm,\n    minimum height=1.8cm\n  },\n  correction/.style={\n    box,draw=resborder,fill=resfill,\n    minimum width=2.8cm,text width=2.5cm,\n    minimum height=1.8cm\n  },\n  prediction/.style={\n    box,draw=predborder,fill=predfill,\n    minimum width=3cm,text width=2.7cm,\n    minimum height=1.8cm\n  },\n  evaluation/.style={\n    box,draw=evalborder,fill=white,\n    minimum width=4.25cm,text width=3.8cm,\n    minimum height=2.3cm,\n    inner xsep=6pt\n  },\n  computation/.style={\n    draw=arrowgray,\n    line width=0.8pt,\n    -{Stealth[length=5pt,width=4pt]},\n    rounded corners=2pt\n  },\n  reuse/.style={\n    draw=obsborder,\n    line width=0.6pt,\n    dash pattern=on 3pt off 2pt,\n    -{Stealth[length=5pt,width=4pt]},\n    rounded corners=3pt\n  },\n  mathlabel/.style={\n    font=\\fontsize{10}{12}\\selectfont,\n    fill=white,\n    inner sep=2pt\n  }\n]\n\n% Explicit 16:9 drawing canvas. Native widths preserve readable\n% typography, the evaluation text, and all requested interstage gaps.\n\\path[use as bounding box]\n  (-0.45,-4.5) rectangle (20.35,7.2);\n\\fill[white] (-0.45,-4.5) rectangle (20.35,7.2);\n\n% Stage 1: observations.\n\\node[observation] (obs) at (1.5,0.75) {%\n  Observations ($n=5$)\\\\[7pt]\n  \\begingroup\n  \\renewcommand{\\arraystretch}{1.18}\n  \\setlength{\\tabcolsep}{8pt}\n  \\begin{tabular}{@{}cc@{}}\n    $x$ & $y=2x+3$\\\\\n    \\hline\n    $-2$ & $-1$\\\\\n    $-1$ & $1$\\\\\n    $0$  & $3$\\\\\n    $1$  & $5$\\\\\n    $2$  & $7$\n  \\end{tabular}\n  \\endgroup\n};\n\n% Stage 2: baseline above residual computation.\n\\node[residual,right=0.8cm of obs,yshift=-0.75cm] (res) {%\n  Residuals\\\\[5pt]\n  {\\fontsize{10}{12}\\selectfont $r_i=y_i-2x_i$}\\\\[5pt]\n  $r_i=3,\\,3,\\,3,\\,3,\\,3$\\\\[3pt]\n  {\\fontsize{8}{10}\\selectfont $(i=1,\\dots,5)$}\n};\n\n\\node[baseline,above=0.8cm of res] (base) {%\n  Fixed baseline\\\\[5pt]\n  {\\fontsize{10}{12}\\selectfont $\\hat{y}^{(0)}=2x$}\n};\n\n% Stages 3--5.\n\\node[correction,right=1cm of res] (bias) {%\n  {\\fontsize{10}{12}\\selectfont\n    $\\displaystyle b=\\frac{1}{5}\\sum_{i=1}^{5}r_i=3$}\n};\n\n\\node[prediction,right=1cm of bias] (pred) {%\n  Corrected prediction\\\\[6pt]\n  {\\fontsize{10}{12}\\selectfont $\\hat{y}_i=2x_i+b$}\n};\n\n\\node[evaluation,right=1cm of pred] (eval) {%\n  Evaluation on the same\\\\\n  5 observations\\\\[7pt]\n  {\\fontsize{10}{12}\\selectfont $e_i=\\hat{y}_i-y_i=0$}\\\\[7pt]\n  {\\fontsize{8}{10}\\selectfont\n    finite arithmetic check,\\\\\n    not generalization}\n};\n\n% Observed x values enter the fixed baseline through a stepped route.\n\\coordinate (xsource) at ($(obs.east)+(0,0.85cm)$);\n\\coordinate (xstep) at ($(xsource)+(0.4cm,0)$);\n\\draw[computation]\n  (xsource) -- (xstep)\n  -- (xstep |- base.west)\n  -- node[mathlabel,above=2pt] {$x$} (base.west);\n\n% Observed outcomes and baseline predictions define the residuals.\n\\draw[computation]\n  (obs.east |- res.west)\n  -- node[mathlabel,above=2pt] {$y_i$} (res.west);\n\n\\draw[computation]\n  (base.south)\n  -- node[mathlabel,right=3pt] {$2x_i$} (res.north);\n\n% Residuals determine the scalar correction.\n\\draw[computation] (res.east) -- (bias.west);\n\\coordinate (dependencymid) at ($(res.east)!0.5!(bias.west)$);\n\n\\node[\n  anchor=north,\n  align=center,\n  text width=4.2cm,\n  inner sep=0pt,\n  font=\\fontsize{8}{10}\\selectfont\\itshape\n] at ($(dependencymid)+(0,-1.3cm)$) {%\n  data dependency: correction computed\\\\\n  from observed residuals\n};\n\n% The baseline contribution follows a separate upper corridor.\n\\coordinate (basetop) at ($(base.north)+(0,1.3cm)$);\n\\draw[computation]\n  (base.north) -- (basetop)\n  -- node[mathlabel,above=3pt] {$2x_i$}\n     (basetop -| pred.north)\n  -- (pred.north);\n\n\\draw[computation]\n  (bias.east)\n  -- node[mathlabel,above=3pt] {$+b$} (pred.west);\n\n\\draw[computation] (pred.east) -- (eval.west);\n\n% A dedicated lower corridor makes reuse of the observations explicit.\n\\coordinate (reuseleft) at (obs.south |- 0,-3.05);\n\\coordinate (reuseright) at (eval.south |- 0,-3.05);\n\\draw[reuse]\n  (obs.south) -- (reuseleft)\n  -- node[\n    midway,\n    above=4pt,\n    text=obsborder,\n    fill=white,\n    inner sep=2pt,\n    font=\\fontsize{8}{10}\\selectfont\n  ] {same observations reused}\n  (reuseright) -- (eval.south);\n\n\\end{tikzpicture}\n\\end{document}"