"```r\nlibrary(ggplot2)\n\ndf <- data.frame(\n  b   = c(0, 1.5, 3),\n  mse = c(9, 2.25, 0),\n  lab = c(\"9\", \"2.25\", \"0\")\n)\n\np <- ggplot(df, aes(x = b, y = mse)) +\n  geom_point(shape = 16, size = 3.2, colour = \"#1F4E79\") +\n  geom_text(aes(label = lab), nudge_y = 0.5, size = 3.5,\n            colour = \"#1F4E79\", family = \"sans\") +\n  scale_x_continuous(name = \"Intercept correction b\",\n                     breaks = c(0, 1.5, 3),\n                     labels = c(\"0\", \"1.5\", \"3\"),\n                     limits = c(-0.25, 3.25)) +\n  scale_y_continuous(name = \"Mean squared error (MSE)\",\n                     breaks = c(0, 3, 6, 9),\n                     limits = c(-0.5, 10)) +\n  labs(title = \"Recorded Mean Squared Error at Three Intercept Corrections\") +\n  theme_classic(base_size = 10, base_family = \"sans\") +\n  theme(\n    plot.title         = element_text(size = 13, face = \"bold\", colour = \"#222222\", hjust = 0),\n    axis.title         = element_text(size = 12, colour = \"#222222\"),\n    axis.text          = element_text(size = 10, colour = \"#222222\"),\n    axis.line          = element_line(linewidth = 0.4, colour = \"#222222\"),\n    axis.ticks         = element_line(linewidth = 0.4, colour = \"#222222\"),\n    axis.ticks.length  = unit(2.5, \"pt\"),\n    panel.grid.major.y = element_line(linewidth = 0.3, colour = \"#D9D9D9\"),\n    panel.grid.major.x = element_blank(),\n    panel.grid.minor   = element_blank(),\n    legend.position    = \"none\",\n    plot.background    = element_rect(fill = \"#FFFFFF\", colour = NA)\n  )\n```"