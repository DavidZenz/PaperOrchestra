"\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usetikzlibrary{arrows.meta,positioning,calc}\n\n\\definecolor{arrowgray}{HTML}{333333}\n\\definecolor{inputfill}{HTML}{EAF1F8}\n\\definecolor{inputborder}{HTML}{4A6B8A}\n\\definecolor{baselinefill}{HTML}{FBEBD9}\n\\definecolor{baselineborder}{HTML}{B8702E}\n\\definecolor{residualfill}{HTML}{E4F2E7}\n\\definecolor{residualborder}{HTML}{3C7A4A}\n\\definecolor{correctionfill}{HTML}{EDE4F5}\n\\definecolor{correctionborder}{HTML}{6A4C93}\n\\definecolor{predictionfill}{HTML}{E3EEF9}\n\\definecolor{predictionborder}{HTML}{2F5F8A}\n\\definecolor{evaluationfill}{HTML}{F2F2F2}\n\\definecolor{evaluationborder}{HTML}{7F7F7F}\n\n\\begin{document}\n\\begin{tikzpicture}[\n  x=1cm,y=1cm,\n  common/.style={\n    rectangle,\n    rounded corners=2mm,\n    line width=0.6pt,\n    minimum height=1.4cm,\n    align=center,\n    text depth=0.25ex,\n    text height=1.2ex,\n    font=\\footnotesize\n  },\n  block/.style={\n    common,\n    minimum width=2.8cm,\n    minimum height=1.6cm,\n    inner xsep=2pt,\n    inner ysep=3pt,\n    text height=,\n    text depth=\n  },\n  flow/.style={\n    -{Stealth[length=2.5mm,width=1.8mm]},\n    line width=0.8pt,\n    draw=arrowgray,\n    rounded corners=1.5mm\n  },\n  labeltext/.style={\n    font=\\footnotesize,\n    text=arrowgray,\n    fill=white,\n    inner sep=2pt,\n    align=center\n  }\n]\n\n% Borderless white canvas, approximately 16:9.\n\\path[use as bounding box] (0,-0.2) rectangle (15.6,8.575);\n\\fill[white] (0,-0.2) rectangle (15.6,8.575);\n\n\\node[block,fill=inputfill,draw=inputborder]\n  (inputs) at (1.8,5.6) {%\n    \\begin{tabular}{@{}c@{}}\n      \\textbf{Observed Inputs \\&}\\\\[-2pt]\n      \\textbf{Targets}\\\\[-1pt]\n      $x_i\\in\\{-2,-1,0,1,2\\}$\\\\[-1pt]\n      $y_i=2x_i+3$\\\\[-1pt]\n      {\\scriptsize Values: $\\{-1,1,3,5,7\\}$}\n    \\end{tabular}\n  };\n\n\\node[\n  block,\n  fill=baselinefill,\n  draw=baselineborder,\n  dash pattern=on 3pt off 2pt\n] (baseline) at (5.8,5.6) {%\n    \\begin{tabular}{@{}c@{}}\n      \\textbf{Fixed Baseline}\\\\[-2pt]\n      \\textbf{Predictor}\\\\[1pt]\n      $\\hat{y}^{(0)}_i=2x_i$\\\\[1pt]\n      {\\scriptsize Values: $\\{-4,-2,0,2,4\\}$}\n    \\end{tabular}\n  };\n\n\\node[block,fill=residualfill,draw=residualborder]\n  (residuals) at (9.8,5.6) {%\n    \\begin{tabular}{@{}c@{}}\n      \\textbf{Observed Residuals}\\\\[3pt]\n      $r_i=y_i-2x_i$\\\\[3pt]\n      {\\scriptsize Values: $\\{3,3,3,3,3\\}$}\n    \\end{tabular}\n  };\n\n\\node[\n  block,\n  fill=correctionfill,\n  draw=correctionborder,\n  line width=1.2pt\n] (correction) at (13.8,5.6) {%\n    \\begin{tabular}{@{}c@{}}\n      \\textbf{Mean Residual}\\\\[-2pt]\n      \\textbf{(Correction)}\\\\[4pt]\n      {\\small $\\displaystyle\n        \\boldsymbol{b=\\frac{1}{5}\\sum_{i=1}^{5}r_i=3}$}\n    \\end{tabular}\n  };\n\n\\node[\n  block,\n  minimum width=3.2cm,\n  fill=predictionfill,\n  draw=predictionborder,\n  line width=0.8pt\n] (prediction) at (9.8,2.4) {%\n    \\begin{tabular}{@{}c@{}}\n      \\textbf{Corrected Prediction}\\\\[3pt]\n      $\\hat{y}_i=2x_i+b$\\\\[3pt]\n      {\\scriptsize Values: $\\{-1,1,3,5,7\\}$}\n    \\end{tabular}\n  };\n\n\\node[\n  block,\n  fill=evaluationfill,\n  draw=evaluationborder,\n  dash pattern=on 3pt off 2pt\n] (evaluation) at (13.8,2.4) {%\n    \\begin{tabular}{@{}c@{}}\n      \\textbf{In-Sample Evaluation}\\\\[3pt]\n      $e_i=y_i-\\hat{y}_i=0$\\\\[3pt]\n      {\\scriptsize Exact arithmetic check}\n    \\end{tabular}\n  };\n\n% Inputs and fixed baseline.\n\\draw[flow]\n  (inputs.east) --\n  node[labeltext,above=2pt] {$x_i$}\n  node[labeltext,below=2pt,font=\\scriptsize] {(fixed map)}\n  (baseline.west);\n\n% Direct target feed, clear of the baseline.\n\\draw[flow]\n  (inputs.north)\n  to[out=45,in=135,looseness=1.15]\n  node[labeltext,above=3pt,pos=0.5] {$y_i$}\n  (residuals.north);\n\n\\draw[flow]\n  (baseline.east) --\n  node[labeltext,above=2pt] {$-2x_i$}\n  (residuals.west);\n\n\\draw[flow]\n  (residuals.east) --\n  node[\n    labeltext,\n    above=3pt,\n    font=\\scriptsize\n  ] {\\shortstack{mean over\\\\5 points}}\n  (correction.west);\n\n% Baseline contribution to the corrected prediction.\n\\draw[flow]\n  (baseline.south) |-\n  node[labeltext,above=2pt,pos=0.76] {$2x_i$}\n  (prediction.west);\n\n% Separate right-edge ports keep correction and comparison arrows distinct.\n\\coordinate (correctionentry)\n  at ($(prediction.east)+(0,0.35)$);\n\n\\draw[\n  flow,\n  draw=correctionborder,\n  line width=1.2pt\n]\n  (correction.south) --\n  (13.8,3.95) --\n  node[\n    labeltext,\n    above=2pt,\n    text=correctionborder\n  ] {$\\boldsymbol{+b}$}\n  (11.85,3.95) --\n  (11.85,2.75) --\n  (correctionentry);\n\n\\draw[flow]\n  (prediction.east) --\n  node[labeltext,above=8mm]\n    {compare $\\hat{y}_i,y_i$}\n  (evaluation.west);\n\n% The same observations are reused for correction and evaluation.\n\\draw[\n  flow,\n  dash pattern=on 4pt off 2pt\n]\n  (inputs.south) --\n  (1.8,0.8) --\n  node[\n    labeltext,\n    above=3pt,\n    font=\\scriptsize\\itshape,\n    pos=0.5\n  ] {same five observations reused for correction and evaluation}\n  (13.8,0.8) --\n  (evaluation.south);\n\n\\end{tikzpicture}\n\\end{document}"