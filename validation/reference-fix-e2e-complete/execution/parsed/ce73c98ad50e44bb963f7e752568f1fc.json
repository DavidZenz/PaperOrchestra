"\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usepackage{graphicx}\n\\usetikzlibrary{arrows.meta,positioning,calc}\n\n\\definecolor{arrowgray}{HTML}{333333}\n\\definecolor{inputfill}{HTML}{EAF1F8}\n\\definecolor{inputborder}{HTML}{4A6B8A}\n\\definecolor{baselinefill}{HTML}{FBEBD9}\n\\definecolor{baselineborder}{HTML}{B8702E}\n\\definecolor{residualfill}{HTML}{E4F2E7}\n\\definecolor{residualborder}{HTML}{3C7A4A}\n\\definecolor{correctionfill}{HTML}{EDE4F5}\n\\definecolor{correctionborder}{HTML}{6A4C93}\n\\definecolor{predictionfill}{HTML}{E3EEF9}\n\\definecolor{predictionborder}{HTML}{2F5F8A}\n\\definecolor{evaluationfill}{HTML}{F2F2F2}\n\\definecolor{evaluationborder}{HTML}{7F7F7F}\n\n\\begin{document}\n\\resizebox{8.6cm}{!}{%\n\\begin{tikzpicture}[\n    x=1cm,\n    y=1.5cm,\n    font=\\normalfont,\n    box/.style={\n        rectangle,\n        rounded corners=2mm,\n        line width=0.6pt,\n        minimum width=2.8cm,\n        minimum height=1.5cm,\n        text width=2.6cm,\n        inner xsep=1mm,\n        inner ysep=1mm,\n        align=center,\n        font=\\footnotesize\n    },\n    flow/.style={\n        -{Stealth[length=2.5mm,width=1.8mm]},\n        line width=0.8pt,\n        draw=arrowgray,\n        rounded corners=1mm\n    },\n    correctionflow/.style={\n        flow,\n        draw=correctionborder,\n        line width=1.2pt\n    },\n    label/.style={\n        font=\\footnotesize,\n        text=arrowgray,\n        inner sep=1.5pt,\n        align=center\n    }\n]\n\n% White, borderless 16:9 canvas.\n\\path[fill=white]\n    (0,0) rectangle (15.6,5.85);\n\\useasboundingbox (0,0) rectangle (15.6,5.85);\n\n\\node[box,fill=inputfill,draw=inputborder]\n    (inputs) at (1.8,4.6) {%\n        \\textbf{Observed Inputs \\& Targets}\\\\\n        $x_i\\in\\{-2,-1,0,1,2\\}$\\\\\n        $y_i=2x_i+3$\\\\\n        {\\scriptsize Values: $\\{-1,1,3,5,7\\}$}\n    };\n\n\\node[box,fill=baselinefill,draw=baselineborder,\n      dash pattern=on 3pt off 2pt]\n    (baseline) at (5.8,4.6) {%\n        \\textbf{Fixed Baseline Predictor}\\\\\n        $\\hat{y}^{(0)}_i=2x_i$\\\\\n        {\\scriptsize Values: $\\{-4,-2,0,2,4\\}$}\n    };\n\n\\node[box,fill=residualfill,draw=residualborder]\n    (residuals) at (9.8,4.6) {%\n        \\textbf{Observed Residuals}\\\\\n        $r_i=y_i-2x_i$\\\\\n        {\\scriptsize Values: $\\{3,3,3,3,3\\}$}\n    };\n\n\\node[box,fill=correctionfill,draw=correctionborder,\n      line width=1.2pt]\n    (correction) at (13.8,4.6) {%\n        \\textbf{Mean Residual (Correction)}\\\\[2pt]\n        {\\small $\\displaystyle\n        \\boldsymbol{b=\\frac{1}{5}\\sum_{i=1}^{5}r_i=3}$}\n    };\n\n\\node[box,minimum width=3.2cm,text width=3cm,\n      fill=predictionfill,draw=predictionborder,line width=0.8pt]\n    (prediction) at (9.8,1.8) {%\n        \\textbf{Corrected Prediction}\\\\\n        $\\hat{y}_i=2x_i+b$\\\\\n        {\\scriptsize Values: $\\{-1,1,3,5,7\\}$}\n    };\n\n\\node[box,fill=evaluationfill,draw=evaluationborder,\n      dash pattern=on 3pt off 2pt]\n    (evaluation) at (13.8,1.8) {%\n        \\textbf{In-Sample Evaluation}\\\\\n        $e_i=y_i-\\hat{y}_i=0$\\\\\n        {\\scriptsize Exact arithmetic check}\n    };\n\n\\draw[flow]\n    (inputs.east) --\n    node[label,above] {$x_i$}\n    node[label,below,font=\\scriptsize] {fixed}\n    (baseline.west);\n\n\\draw[flow]\n    (inputs.north)\n    to[out=30,in=150,looseness=0.8]\n    node[label,above=2pt] {$y_i$}\n    (residuals.north);\n\n\\draw[flow]\n    (baseline.east) --\n    node[label,above] {$-2x_i$}\n    (residuals.west);\n\n\\draw[flow]\n    (residuals.east) --\n    node[label,above,font=\\scriptsize] {mean over\\\\5 points}\n    (correction.west);\n\n\\draw[flow]\n    (baseline.south) --\n    (baseline.south |- prediction.west) --\n    node[label,above] {$2x_i$}\n    (prediction.west);\n\n\\coordinate (correctionturn) at\n    (correction.south |- {$(prediction.north)+(0,0.65cm)$});\n\n\\draw[correctionflow]\n    (correction.south) --\n    node[label,right=3pt,text=correctionborder]\n        {\\textbf{$+b$}}\n    (correctionturn) --\n    ($(prediction.north)+(6mm,0.65cm)$)\n    -| (prediction.north);\n\n\\draw[flow]\n    (prediction.east) --\n    node[label,above] {compare\\\\$\\hat{y}_i,y_i$}\n    (evaluation.west);\n\n\\draw[flow,dash pattern=on 4pt off 2pt]\n    (inputs.south) --\n    (1.8,0.6) --\n    node[label,below=3pt,font=\\scriptsize\\itshape]\n        {same five observations reused for correction and evaluation}\n    (13.8,0.6) --\n    (evaluation.south);\n\n\\end{tikzpicture}%\n}\n\\end{document}"