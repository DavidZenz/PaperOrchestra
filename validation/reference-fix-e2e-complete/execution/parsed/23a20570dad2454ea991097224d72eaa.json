"```r\nlibrary(ggplot2)\n\ndf <- data.frame(\n  b   = c(0, 1.5, 3),\n  mse = c(9, 2.25, 0)\n)\n\np <- ggplot(df, aes(x = b, y = mse)) +\n  geom_vline(xintercept = df$b, colour = \"#E3E3E3\",\n             linewidth = 0.3, linetype = \"dashed\") +\n  geom_point(shape = 21, size = 4, fill = \"#1F4E79\",\n             colour = \"#FFFFFF\", stroke = 0.6) +\n  geom_text(aes(label = paste0(\"MSE = \", format(mse, drop0trailing = TRUE))),\n            vjust = -1.1, hjust = 0.5, size = 3.5, colour = \"#1F4E79\") +\n  scale_x_continuous(limits = c(-0.25, 3.25), breaks = c(0, 1.5, 3)) +\n  scale_y_continuous(limits = c(-0.5, 10), breaks = seq(0, 10, by = 2)) +\n  labs(\n    title   = \"Measured Mean Squared Error at Three Intercept Corrections\",\n    x       = \"Added intercept correction b\",\n    y       = \"Mean squared error (MSE)\",\n    caption = \"Each point is one deterministic evaluation on the same five observations used to determine b. No uncertainty is shown.\"\n  ) +\n  theme_minimal(base_family = \"sans\") +\n  theme(\n    plot.background    = element_rect(fill = \"#FFFFFF\", colour = NA),\n    panel.background   = element_rect(fill = \"#FFFFFF\", colour = NA),\n    panel.grid.major.x = element_blank(),\n    panel.grid.minor   = element_blank(),\n    panel.grid.major.y = element_line(colour = \"#E3E3E3\", linewidth = 0.4),\n    axis.line          = element_line(colour = \"#444444\", linewidth = 0.5),\n    axis.ticks         = element_line(colour = \"#444444\"),\n    axis.ticks.length  = unit(3, \"pt\"),\n    plot.title         = element_text(size = 14, face = \"bold\", colour = \"#1A1A1A\"),\n    axis.title         = element_text(size = 12, colour = \"#333333\"),\n    axis.text          = element_text(size = 10, colour = \"#444444\"),\n    plot.caption       = element_text(size = 9, face = \"italic\", colour = \"#666666\", hjust = 0),\n    legend.position    = \"none\",\n    plot.margin        = margin(10, 10, 10, 10, \"pt\")\n  )\n```"