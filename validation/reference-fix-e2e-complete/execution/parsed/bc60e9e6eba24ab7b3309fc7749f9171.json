"\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usepackage{graphicx}\n\\usetikzlibrary{arrows.meta,calc}\n\n\\definecolor{arrowgray}{HTML}{333333}\n\\definecolor{inputfill}{HTML}{EAF1F8}\n\\definecolor{inputedge}{HTML}{4A6B8A}\n\\definecolor{basefill}{HTML}{FBEBD9}\n\\definecolor{baseedge}{HTML}{B8702E}\n\\definecolor{resfill}{HTML}{E4F2E7}\n\\definecolor{resedge}{HTML}{3C7A4A}\n\\definecolor{scalarfill}{HTML}{EDE4F5}\n\\definecolor{scalaredge}{HTML}{6A4C93}\n\\definecolor{predfill}{HTML}{E3EEF9}\n\\definecolor{prededge}{HTML}{2F5F8A}\n\\definecolor{evalfill}{HTML}{F2F2F2}\n\\definecolor{evaledge}{HTML}{7F7F7F}\n\n\\begin{document}\n\\resizebox{3.4in}{!}{%\n\\begin{tikzpicture}[\n    x=1cm,y=1cm,\n    box/.style={\n        rectangle,\n        rounded corners=2mm,\n        line width=0.6pt,\n        minimum width=2.8cm,\n        minimum height=1.6cm,\n        inner sep=0pt,\n        outer sep=0pt\n    },\n    flow/.style={\n        draw=arrowgray,\n        line width=0.8pt,\n        -{Triangle[length=2.3mm,width=1.7mm]},\n        rounded corners=1mm\n    },\n    label/.style={\n        font=\\small,\n        inner sep=1.2pt,\n        align=center\n    },\n    content/.style={\n        font=\\small,\n        inner sep=0pt,\n        align=center\n    }\n]\n% White, borderless 16:9 canvas.\n\\path[use as bounding box] (0,0) rectangle (16,9);\n\\fill[white] (0,0) rectangle (16,9);\n\n% Fixed-size node shapes.\n\\node[box,fill=inputfill,draw=inputedge]\n    (inputs) at (1.8,5.5) {};\n\\node[box,fill=basefill,draw=baseedge,\n      dash pattern=on 3pt off 2pt]\n    (baseline) at (6.0,5.5) {};\n\\node[box,fill=resfill,draw=resedge]\n    (residuals) at (10.2,5.5) {};\n\\node[box,fill=scalarfill,draw=scalaredge,line width=1.2pt]\n    (scalar) at (14.2,5.5) {};\n\\node[box,minimum width=3.2cm,fill=predfill,draw=prededge]\n    (prediction) at (10.2,2.6) {};\n\\node[box,fill=evalfill,draw=evaledge,\n      dash pattern=on 3pt off 2pt]\n    (evaluation) at (14.2,2.6) {};\n\n% Compact Computer Modern text, kept separate from the fixed-size shapes.\n\\node[content] at (inputs.center) {%\n    \\renewcommand{\\arraystretch}{0.74}%\n    \\begin{tabular}{@{}c@{}}\n        $\\text{Observed inputs}$\\\\\n        $\\text{and targets}$\\\\\n        $x_i\\in\\{-2,-1,0,1,2\\}$\\\\\n        $y_i=2x_i+3$\\\\\n        {\\footnotesize $\\{-1,1,3,5,7\\}$}\n    \\end{tabular}\n};\n\\node[content] at (baseline.center) {%\n    \\renewcommand{\\arraystretch}{0.85}%\n    \\begin{tabular}{@{}c@{}}\n        $\\text{Fixed baseline}$\\\\\n        $\\text{predictor}$\\\\\n        $\\hat y^{(0)}_i=2x_i$\\\\\n        {\\footnotesize $\\{-4,-2,0,2,4\\}$}\n    \\end{tabular}\n};\n\\node[content] at (residuals.center) {%\n    \\renewcommand{\\arraystretch}{1.05}%\n    \\begin{tabular}{@{}c@{}}\n        $\\text{Observed residuals}$\\\\\n        $r_i=y_i-2x_i$\\\\\n        $\\{3,3,3,3,3\\}$\n    \\end{tabular}\n};\n\\node[content] at (scalar.center) {%\n    \\renewcommand{\\arraystretch}{1.15}%\n    \\begin{tabular}{@{}c@{}}\n        $\\text{Mean residual}$\\\\\n        $\\displaystyle\\boldsymbol{b=\\frac{1}{5}\\sum_{i=1}^{5}r_i=3}$\n    \\end{tabular}\n};\n\\node[content] at (prediction.center) {%\n    \\renewcommand{\\arraystretch}{1.05}%\n    \\begin{tabular}{@{}c@{}}\n        $\\text{Corrected prediction}$\\\\\n        $\\hat y_i=2x_i+b$\\\\\n        {\\footnotesize $\\{-1,1,3,5,7\\}$}\n    \\end{tabular}\n};\n\\node[content] at (evaluation.center) {%\n    \\renewcommand{\\arraystretch}{0.74}%\n    \\begin{tabular}{@{}c@{}}\n        $\\text{Evaluation on the}$\\\\\n        $\\text{same five points}$\\\\\n        $e_i=y_i-\\hat y_i=0$\\\\\n        {\\footnotesize $\\text{in-sample arithmetic check}$}\n    \\end{tabular}\n};\n\n% Observed inputs feed the fixed map.\n\\draw[flow] (inputs.east) --\n    node[label,above=2pt] {$x_i$}\n    node[label,below=2pt,font=\\footnotesize] {$\\text{fixed map}$}\n    (baseline.west);\n\n% Observed targets bypass the baseline and enter only the residual node.\n\\draw[flow] (inputs.north)\n    .. controls (1.8,8.05) and (10.2,8.05) ..\n    node[label,pos=0.5,above=3pt] {$y_i$}\n    (residuals.north);\n\n\\draw[flow] (baseline.east) --\n    node[label,above=2pt] {$-\\,2x_i$}\n    (residuals.west);\n\n\\draw[flow] (residuals.east) --\n    node[label,above=3pt,font=\\footnotesize]\n        {$\\text{mean over}$\\\\$\\text{the five points}$}\n    (scalar.west);\n\n% The unchanged baseline prediction feeds the corrected prediction.\n\\draw[flow] (baseline.south) --\n    (6.0,2.6) --\n    node[label,above=3pt] {$2x_i$}\n    (prediction.west);\n\n% One scalar output; the route clears the evaluation box and comparison arrow.\n\\draw[flow,draw=scalaredge,line width=1.2pt]\n    (scalar.south) --\n    (14.2,3.95) --\n    node[label,above=3pt,text=scalaredge] {$+\\,b$}\n    (12.2,3.95) --\n    (12.2,3.05) --\n    ($(prediction.east)+(0,0.45)$);\n\n\\draw[flow] (prediction.east) --\n    node[label,above=3pt,font=\\footnotesize]\n        {$\\hat y_i\\ \\text{compared}$\\\\$\\text{with}\\ y_i$}\n    (evaluation.west);\n\n% The same observations are reused for correction and evaluation.\n\\draw[flow,dash pattern=on 4pt off 2pt]\n    (inputs.south) --\n    (1.8,0.8) --\n    node[midway,above=4pt,font=\\footnotesize,inner sep=1pt]\n        {\\textit{same five observations reused for correction and evaluation}}\n    (14.2,0.8) --\n    (evaluation.south);\n\n\\end{tikzpicture}%\n}\n\\end{document}"