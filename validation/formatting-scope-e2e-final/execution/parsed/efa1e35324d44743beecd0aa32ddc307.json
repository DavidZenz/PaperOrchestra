"\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usetikzlibrary{arrows,calc}\n\n\\definecolor{dataBlue}{HTML}{4C78A8}\n\\definecolor{baselineGray}{HTML}{8C8C8C}\n\\definecolor{residualAmber}{HTML}{E08E2B}\n\\definecolor{correctionTeal}{HTML}{2A9D8F}\n\\definecolor{predictionGreen}{HTML}{59A14F}\n\\definecolor{charcoal}{HTML}{3A3A3A}\n\n\\newcommand{\\modulelabel}[1]{%\n  {\\sffamily\\fontsize{10}{12}\\selectfont\\bfseries #1}%\n}\n\n\\begin{document}\n\\begin{tikzpicture}[\n  font=\\fontsize{9}{11}\\selectfont,\n  block/.style={\n    rectangle,\n    rounded corners=3pt,\n    line width=0.8pt,\n    inner xsep=6pt,\n    inner ysep=6pt,\n    outer sep=0pt,\n    align=center\n  },\n  flow/.style={\n    -latex,\n    line width=1.2pt,\n    draw=charcoal\n  },\n  mathlabel/.style={\n    font=\\fontsize{9}{11}\\selectfont,\n    inner sep=2pt,\n    fill=white\n  },\n  smalllabel/.style={\n    font=\\sffamily\\fontsize{8}{9.5}\\selectfont,\n    inner sep=2pt,\n    fill=white,\n    align=center\n  }\n]\n\n% White canvas with the requested 4:3 aspect ratio.\n\\path[use as bounding box] (0,0) rectangle (15.8,11.85);\n\\fill[white] (0,0) rectangle (15.8,11.85);\n\n% Column 1: observations.\n\\node[\n  block,\n  draw=dataBlue,\n  fill=dataBlue!11!white,\n  text width=3.95cm,\n  minimum height=1.8cm\n] (D) at (2.25,8.6) {%\n  \\modulelabel{Observations}\\\\[5pt]\n  $x=(-2,-1,0,1,2)$\\\\[4pt]\n  $y=2x+3=(-1,1,3,5,7)$\n};\n\n% Column 2: residuals and baseline.\n\\node[\n  block,\n  draw=residualAmber,\n  fill=residualAmber!11!white,\n  text width=2.1cm,\n  minimum height=1.8cm\n] (R) at (6.25,8.6) {%\n  \\modulelabel{Residuals}\\\\[5pt]\n  $r_i=y_i-2x_i$\\\\[4pt]\n  $(3,3,3,3,3)$\n};\n\n\\node[\n  block,\n  draw=baselineGray,\n  fill=baselineGray!11!white,\n  text width=2.65cm,\n  minimum height=1.8cm\n] (B) at (6.25,5.4) {%\n  \\modulelabel{Baseline predictor}\\\\[5pt]\n  $\\hat{y}_0=2x$\\\\[4pt]\n  $(-4,-2,0,2,4)$\n};\n\n% Column 3: scalar correction.\n\\node[\n  block,\n  draw=correctionTeal,\n  fill=correctionTeal,\n  text=white,\n  minimum width=1.7cm,\n  minimum height=0.85cm\n] (S) at (10.2,8.6) {%\n  $\\boldsymbol{b=\\bar{r}=3}$\n};\n\n% Column 4: corrected prediction and evaluation.\n\\node[\n  block,\n  draw=predictionGreen,\n  fill=predictionGreen!11!white,\n  text width=3.55cm,\n  minimum height=1.8cm\n] (C) at (13.5,5.4) {%\n  \\modulelabel{Corrected prediction}\\\\[5pt]\n  $\\hat{y}=2x+b$\\\\[4pt]\n  $(-1,1,3,5,7)$\n};\n\n\\node[\n  block,\n  draw=charcoal,\n  fill=white,\n  text width=3.55cm,\n  minimum height=1.85cm\n] (E) at (13.5,2.65) {%\n  \\modulelabel{Evaluation on the}\\\\[-1pt]\n  \\modulelabel{same five points}\\\\[5pt]\n  {\\sffamily\\fontsize{9}{11}\\selectfont\n   in-sample check;\\\\\n   no held-out data}\n};\n\n% Observed targets enter the residual calculation directly.\n\\draw[flow,draw=dataBlue]\n  (D.east) -- (R.west)\n  node[mathlabel,pos=0.88,above=2pt] {$y$};\n\n% Inputs branch downward and then right into the baseline.\n\\coordinate (inputExit) at ($(D.south)+(0.95,0)$);\n\\draw[flow,draw=dataBlue]\n  (inputExit) |- (B.west);\n\\node[mathlabel,above=2pt]\n  at ($(inputExit |- B.west)!0.5!(B.west)$) {$x$};\n\n% Baseline predictions enter the residual calculation vertically.\n\\draw[flow,draw=baselineGray]\n  (B.north) -- (R.south)\n  node[mathlabel,midway,right=3pt] {$2x$};\n\n% Mean residual: a continuous amber-to-teal connector.\n\\coordinate (meanMid) at ($(R.east)!0.5!(S.west)$);\n\\draw[draw=residualAmber,line width=1.4pt]\n  (R.east) -- (meanMid);\n\\draw[-latex,draw=correctionTeal,line width=1.4pt]\n  (meanMid) -- (S.west);\n\\node[\n  font=\\sffamily\\fontsize{8}{9.5}\\selectfont,\n  align=center,\n  inner sep=0pt,\n  anchor=south\n] at ($(meanMid)+(0,3pt)$) {mean over five\\\\residuals};\n\n% Baseline contribution to the corrected prediction.\n\\draw[flow,draw=baselineGray]\n  (B.east) -- (C.west)\n  node[mathlabel,midway,above=3pt] {$2x$};\n\n% Scalar correction steps down and right into the prediction.\n\\draw[flow,draw=correctionTeal]\n  (S.south)\n  -- (10.2,7.15)\n  -- (13.5,7.15)\n  -- (C.north);\n\\node[mathlabel,above=3pt] at (11.85,7.15) {$+b$};\n\n% Corrected predictions are evaluated on the original targets.\n\\draw[flow]\n  (C.south) -- (E.north)\n  node[smalllabel,midway,left=4pt]\n  {compare $\\hat{y}$ with $y$};\n\n% Target reuse: solid blue perimeter route into evaluation's right flank.\n\\draw[-latex,draw=dataBlue,line width=1.0pt]\n  (D.north)\n  -- (2.25,10.55)\n  -- (15.7,10.55)\n  -- (15.7,2.65)\n  -- (E.east);\n\\node[mathlabel,above=2pt] at (8.975,10.55) {$y$};\n\n% Explicit provenance of the reused observations.\n\\coordinate (reuseExit) at ($(D.south)+(-0.95,0)$);\n\\draw[\n  -latex,\n  draw=charcoal,\n  line width=0.8pt,\n  dash pattern=on 4pt off 2.5pt\n]\n  (reuseExit)\n  -- (1.3,0.95)\n  -- (13.5,0.95)\n  -- (E.south);\n\\node[\n  font=\\sffamily\\fontsize{8}{9.5}\\selectfont\\itshape,\n  fill=white,\n  inner sep=1pt,\n  anchor=south\n] at (7.4,1.04) {same five observations reused};\n\n\\end{tikzpicture}\n\\end{document}"