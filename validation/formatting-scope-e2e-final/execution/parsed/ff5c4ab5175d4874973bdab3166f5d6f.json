"\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usepackage[T1]{fontenc}\n\\usetikzlibrary{arrows,calc,positioning}\n\n\\definecolor{dataBlue}{HTML}{4C78A8}\n\\definecolor{baselineGray}{HTML}{8C8C8C}\n\\definecolor{residualAmber}{HTML}{E08E2B}\n\\definecolor{scalarTeal}{HTML}{2A9D8F}\n\\definecolor{predictionGreen}{HTML}{59A14F}\n\\definecolor{charcoal}{HTML}{3A3A3A}\n\n\\begin{document}\n\\begin{tikzpicture}[\n    font=\\sffamily\\fontsize{9}{11}\\selectfont,\n    text=charcoal,\n    box/.style={\n        rectangle,\n        rounded corners=3pt,\n        line width=0.8pt,\n        align=center,\n        inner xsep=7pt,\n        inner ysep=9pt\n    },\n    flow/.style={\n        -latex,\n        line width=1.2pt,\n        draw=charcoal,\n        line join=round\n    },\n    dependency/.style={\n        flow,\n        line width=1.6pt,\n        draw=residualAmber\n    },\n    reuse/.style={\n        -latex,\n        dashed,\n        dash pattern=on 4pt off 3pt,\n        line width=0.8pt,\n        draw=charcoal,\n        rounded corners=5pt\n    },\n    label/.style={\n        font=\\sffamily\\fontsize{8}{10}\\selectfont,\n        align=center,\n        fill=white,\n        inner sep=3pt\n    },\n    header/.style={\n        font=\\sffamily\\bfseries\\fontsize{10}{12}\\selectfont\n    }\n]\n\n% White 4:3 canvas.\n\\path[use as bounding box,fill=white] (0,0) rectangle (16,12);\n\n% Observations.\n\\node[box,draw=dataBlue,fill=dataBlue!12,text width=3.35cm]\n    (D1) at (2.05,9.0) {\n    {\\bfseries\\fontsize{10}{12}\\selectfont Observations}\\\\[7pt]\n    \\(\\begin{aligned}\n        x&=(-2,-1,0,1,2)\\\\[3pt]\n        y=2x+3&=(-1,1,3,5,7)\n    \\end{aligned}\\)\n};\n\n% Computation.\n\\node[box,draw=baselineGray,fill=baselineGray!12,text width=3.0cm]\n    (B) at (6.75,5.8) {\n    {\\bfseries\\fontsize{10}{12}\\selectfont Baseline predictor}\\\\[7pt]\n    \\(\\hat y_0=2x\\)\\\\[4pt]\n    \\((-4,-2,0,2,4)\\)\n};\n\n\\node[box,draw=residualAmber,fill=residualAmber!12,text width=3.0cm]\n    (R) at (6.75,9.0) {\n    {\\bfseries\\fontsize{10}{12}\\selectfont Residuals}\\\\[7pt]\n    \\(r_i=y_i-2x_i\\)\\\\[4pt]\n    \\((3,3,3,3,3)\\)\n};\n\n% The only saturated-fill node.\n\\node[box,draw=scalarTeal,fill=scalarTeal,\n      text=white,text width=1.55cm,minimum height=0.85cm]\n    (S) at (11.15,9.0) {\n    \\(\\boldsymbol{b=\\bar r=3}\\)\n};\n\n% Corrected prediction and evaluation.\n\\node[box,draw=predictionGreen,fill=predictionGreen!12,\n      text width=3.0cm]\n    (C) at (13.4,5.8) {\n    {\\bfseries\\fontsize{10}{12}\\selectfont Corrected prediction}\\\\[7pt]\n    \\(\\hat y=2x+b\\)\\\\[4pt]\n    \\((-1,1,3,5,7)\\)\n};\n\n\\node[box,draw=charcoal,fill=white,text width=3.4cm]\n    (E) at (13.4,2.5) {\n    {\\bfseries\\fontsize{10}{12}\\selectfont\n     Evaluation on the\\\\same five points}\\\\[7pt]\n    in-sample check;\\\\\n    no held-out data\n};\n\n% One shared observation output, branching into x and y.\n\\coordinate (split) at (4.25,9.0);\n\\coordinate (targetbranch) at (4.7,9.0);\n\\draw[line width=1.2pt,draw=charcoal] (D1.east) -- (split);\n\n\\draw[flow]\n    (split) -- (4.25,5.8)\n    -- node[label,above,pos=0.58] {\\(x\\)} (B.west);\n\n\\draw[flow]\n    (split) -- node[label,above,pos=0.68] {\\(y\\)} (R.west);\n\n% Baseline contribution to the observed residuals.\n\\draw[flow]\n    (B.north) -- node[label,right] {\\(2x\\)} (R.south);\n\n% Emphasized observed-residual-to-scalar dependency.\n\\draw[dependency]\n    (R.east) --\n    node[label,above=4pt,text width=1.8cm] {\n        mean over the five\\\\observed residuals\n    }\n    (S.west);\n\n% Combine the baseline and scalar correction.\n\\draw[flow]\n    (B.east) --\n    node[label,above] {baseline \\(2x\\)}\n    (C.west);\n\n\\draw[flow,draw=scalarTeal,rounded corners=5pt]\n    (S.south) --\n    node[label,left,pos=0.55] {\\(+\\,b\\)}\n    (11.15,7.15) -- (13.4,7.15) -- (C.north);\n\n% Prediction enters the evaluation.\n\\draw[flow]\n    (C.south) --\n    node[label,right=3pt] {compare with \\(y\\)}\n    (E.north);\n\n% Explicit target input to evaluation, routed around the upper/right margin.\n\\draw[flow,draw=dataBlue,rounded corners=5pt]\n    (targetbranch) -- (4.7,11.15)\n    -- node[label,above] {\\(y\\)}\n    (15.8,11.15) -- (15.8,2.5) -- (E.east);\n\n% Separate lower-margin reuse dependency.\n\\draw[reuse]\n    (D1.south) -- (2.05,0.75)\n    -- node[label,below=3pt,\n            font=\\sffamily\\itshape\\fontsize{8}{10}\\selectfont] {\n        same five observations reused\n    }\n    (13.4,0.75) -- (E.south);\n\n\\end{tikzpicture}\n\\end{document}"