"```latex\n\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usetikzlibrary{arrows.meta}\n\n\\definecolor{slate}{HTML}{374151}\n\\definecolor{infill}{HTML}{DCE9F7}\n\\definecolor{inborder}{HTML}{2563EB}\n\\definecolor{tgfill}{HTML}{DCFCE7}\n\\definecolor{tgborder}{HTML}{15803D}\n\\definecolor{basefill}{HTML}{F3F4F6}\n\\definecolor{baseborder}{HTML}{6B7280}\n\\definecolor{resfill}{HTML}{FFEDD5}\n\\definecolor{resborder}{HTML}{C2410C}\n\\definecolor{meanfill}{HTML}{FEF3C7}\n\\definecolor{meanborder}{HTML}{B45309}\n\\definecolor{evfill}{HTML}{F3E8FF}\n\\definecolor{evborder}{HTML}{7E22CE}\n\n\\tikzset{\n  arr/.style={draw=slate, line width=0.7pt, -Stealth},\n  box/.style={rounded corners=2pt, line width=0.6pt, align=center,\n              font=\\small, inner sep=3pt},\n  tiny/.style={font=\\fontsize{7.5}{9}\\selectfont}\n}\n\n\\begin{document}\n\\begin{tikzpicture}[x=1cm, y=1cm]\n\n% ---------------- Row 1 ----------------\n\\node[box, draw=inborder, fill=infill, text width=2.2cm] (input) at (1.2,7.6)\n  {$x_i$, $i=1,\\dots,5$\\\\[1pt]{\\footnotesize $x=(-2,-1,0,1,2)$}};\n\\node[box, draw=tgborder, fill=tgfill, text width=2.2cm] (target) at (4.4,7.6)\n  {$y_i = 2x_i + 3$\\\\[1pt]{\\footnotesize $(-1,1,3,5,7)$}};\n\n% ---------------- Row 2 ----------------\n\\node[box, draw=baseborder, fill=basefill, text width=2.2cm] (baseline) at (1.2,5.2)\n  {Fixed predictor\\\\$\\hat{y}_i^{(0)} = 2x_i$\\\\[1pt]{\\footnotesize $(-4,-2,0,2,4)$}};\n\\node[box, draw=resborder, fill=resfill, text width=2.2cm] (residual) at (4.4,5.2)\n  {$r_i = y_i - 2x_i$\\\\[1pt]{\\footnotesize $(3,3,3,3,3)$}};\n\n% ---------------- Row 3 ----------------\n\\node[box, draw=meanborder, fill=meanfill, line width=1.2pt] (meanres) at (4.4,2.7)\n  {$b = \\frac{1}{5}\\sum_{i=1}^{5} r_i = 3$};\n\\node[box, draw=tgborder, fill=tgfill, text width=2.1cm, minimum height=11mm]\n  (corrected) at (7.55,2.7)\n  {$\\hat{y}_i = 2x_i + b$\\\\[1pt]{\\footnotesize $(-1,1,3,5,7)$}};\n\\node[box, draw=evborder, fill=evfill, font=\\footnotesize, text width=2.4cm,\n      minimum height=11mm, dash pattern=on 3pt off 2pt] (eval) at (10.55,2.7)\n  {Evaluate $\\hat{y}_i$ against $y_i$\\\\on the same five $(x_i, y_i)$.};\n\n% ---------------- Arrows ----------------\n\\draw[arr] (input.south) -- (baseline.north)\n  node[midway, right, font=\\small] {$\\times 2$};\n\\draw[arr] (target.south) -- (residual.north)\n  node[midway, right, font=\\small] {$+y_i$};\n\\draw[arr] (baseline.east) -- (residual.west)\n  node[midway, above, font=\\footnotesize] {$-2x_i$};\n\n% Primary data dependency (emphasized amber arrow)\n\\draw[draw=meanborder, line width=1.2pt, -Stealth] (residual.south) -- (meanres.north)\n  node[midway, right=2pt, align=left, tiny] {mean over the\\\\observed residuals};\n\n% Additive correction\n\\draw[arr] (meanres.east) -- (corrected.west)\n  node[midway, above, font=\\small] {$+\\,b$};\n\n% Baseline feed: drop, run along lower margin, rise into corrected prediction\n\\draw[arr] (baseline.south) -- (1.2,1.0) -- (7.55,1.0) -- (corrected.south);\n\\node[font=\\small, anchor=north, inner sep=0] at (4.375,0.894) {$2x_i$};\n\n% Corrected prediction into evaluation\n\\draw[arr] (corrected.east) -- (eval.west)\n  node[midway, above, font=\\footnotesize] {$\\hat{y}_i$};\n\n% Target ground truth: high channel above Row 2, vertical drop into evaluation\n\\draw[draw=baseborder, line width=0.7pt, dashed, -Stealth] (target.east) -| (eval.north)\n  node[pos=0.75, right=2pt, font=\\small] {$y_i$};\n\n% ---------------- Reuse callout ----------------\n\\node[tiny, align=center, text width=2.4cm] at (10.55,1.6)\n  {Same five observations used\\\\to estimate $b$ and to score.};\n\n\\end{tikzpicture}\n\\end{document}\n```"