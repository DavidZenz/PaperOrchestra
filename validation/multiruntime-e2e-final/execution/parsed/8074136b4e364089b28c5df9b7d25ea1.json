"```latex\n\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usetikzlibrary{arrows.meta}\n\n\\definecolor{inFill}{HTML}{DCE9F7}\n\\definecolor{inBorder}{HTML}{2563EB}\n\\definecolor{tgFill}{HTML}{DCFCE7}\n\\definecolor{tgBorder}{HTML}{15803D}\n\\definecolor{blFill}{HTML}{F3F4F6}\n\\definecolor{blBorder}{HTML}{6B7280}\n\\definecolor{resFill}{HTML}{FFEDD5}\n\\definecolor{resBorder}{HTML}{C2410C}\n\\definecolor{meanFill}{HTML}{FEF3C7}\n\\definecolor{meanBorder}{HTML}{B45309}\n\\definecolor{evFill}{HTML}{F3E8FF}\n\\definecolor{evBorder}{HTML}{7E22CE}\n\\definecolor{arrGray}{HTML}{374151}\n\n\\begin{document}\n\\begin{tikzpicture}[\n  x=1cm, y=1cm,\n  box/.style={rounded corners=2pt, line width=0.6pt, align=center,\n              inner sep=3pt, minimum height=1.0cm, font=\\small},\n  arr/.style={draw=arrGray, line width=0.7pt, -{Stealth[length=2.2mm]}},\n  elbow/.style={draw=arrGray, line width=0.5pt, -{Stealth[length=2.2mm]}},\n  amberarr/.style={draw=meanBorder, line width=1.0pt, -{Stealth[length=2.8mm]}},\n  lab/.style={font=\\small, inner sep=1pt}\n]\n\n% ---- Row 1 : data ----------------------------------------------------\n\\node[box, fill=inFill, draw=inBorder, minimum width=2.6cm] (input) at (1.5,7.0)\n  {$x_i,\\; i=1,\\dots,5$\\\\[1pt] $x=(-2,-1,0,1,2)$};\n\\node[box, fill=tgFill, draw=tgBorder, minimum width=2.8cm] (target) at (4.7,7.0)\n  {$y_i = 2x_i+3$\\\\[1pt] $(-1,1,3,5,7)$};\n\n% ---- Row 2 : computation ---------------------------------------------\n\\node[box, fill=blFill, draw=blBorder, minimum width=2.4cm] (baseline) at (1.5,4.3)\n  {fixed predictor\\\\[1pt] $\\hat y_i^{(0)} = 2x_i$\\\\[1pt] $(-4,-2,0,2,4)$};\n\\node[box, fill=resFill, draw=resBorder, minimum width=2.8cm] (residual) at (4.7,4.3)\n  {$r_i = y_i - 2x_i$\\\\[1pt] $(3,3,3,3,3)$};\n\\node[box, fill=evFill, draw=evBorder, dashed, text width=2.3cm] (eval) at (10.5,4.3)\n  {Evaluate $\\hat y_i$ against $y_i$ on the same five $(x_i,y_i)$.};\n\n% ---- Row 3 : scalar and output ---------------------------------------\n\\node[box, fill=meanFill, draw=meanBorder, line width=1.2pt,\n      minimum width=2.8cm] (mean) at (4.7,1.5)\n  {$b = \\dfrac{1}{5}\\sum_{i=1}^{5} r_i = 3$};\n\\node[box, fill=tgFill, draw=tgBorder, minimum width=2.6cm] (corrected) at (8.0,1.5)\n  {$\\hat y_i = 2x_i + b$\\\\[1pt] $(-1,1,3,5,7)$};\n\n% ---- Connections ------------------------------------------------------\n% input -> baseline\n\\draw[arr] (input.south) -- (baseline.north)\n  node[midway, right, lab] {$\\times 2$};\n\n% target -> residual\n\\draw[arr] (target.south) -- (residual.north)\n  node[midway, right, lab] {$y_i$};\n\n% baseline -> residual (subtraction junction)\n\\draw[arr] (baseline.east) -- (residual.west);\n\\node[circle, draw=arrGray, line width=0.5pt, inner sep=0.6pt,\n      font=\\scriptsize] at (3.0,4.3) {$-$};\n\\node[lab, anchor=south] at (3.0,4.47) {$2x_i$};\n\n% residual -> mean (emphasized data dependency)\n\\draw[amberarr] (residual.south) -- (mean.north);\n\\node[lab, anchor=west, align=center] at (4.85,2.95)\n  {mean over the\\\\ observed residuals};\n\n% mean -> corrected (scalar correction)\n\\draw[arr] (mean.east) -- (corrected.west)\n  node[midway, above, lab] {$+\\,b$};\n\n% baseline -> corrected (elbow through the open channel between rows 2 and 3)\n\\draw[elbow] (baseline.south) -- (1.5,2.35) -- (8.0,2.35) -- (corrected.north);\n\\node[lab, anchor=south] at (2.7,2.42) {$2x_i$};\n\n% corrected -> evaluation\n\\draw[arr] ([xshift=-2pt]corrected.north east) -- ([xshift=6pt]eval.south west);\n\\node[lab, anchor=east] at (9.1,2.8) {$\\hat y_i$};\n\n% target -> evaluation (dashed, along the top margin)\n\\draw[arr, dashed] (target.north) -- (4.7,7.9) -- (10.5,7.9) -- (eval.north);\n\\node[lab, anchor=south] at (7.6,7.9) {$y_i$};\n\n% reuse callout beneath the evaluation box\n\\node[font={\\fontsize{7.5}{9}\\selectfont\\itshape}, align=center,\n      text width=2.4cm] at (10.6,2.45)\n  {same five observations used to estimate $b$ and to score.};\n\n\\end{tikzpicture}\n\\end{document}\n```"