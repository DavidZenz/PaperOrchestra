"```latex\n\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usepackage{graphicx}\n\\usetikzlibrary{arrows.meta,positioning,calc}\n\n\\definecolor{slategray}{HTML}{374151}\n\\definecolor{inputblue}{HTML}{2563EB}\n\\definecolor{inputfill}{HTML}{DCE9F7}\n\\definecolor{targetgreen}{HTML}{15803D}\n\\definecolor{targetfill}{HTML}{DCFCE7}\n\\definecolor{baselinegray}{HTML}{6B7280}\n\\definecolor{baselinefill}{HTML}{F3F4F6}\n\\definecolor{resorange}{HTML}{C2410C}\n\\definecolor{resfill}{HTML}{FFEDD5}\n\\definecolor{amberdark}{HTML}{B45309}\n\\definecolor{amberfill}{HTML}{FEF3C7}\n\\definecolor{evalpurple}{HTML}{7E22CE}\n\\definecolor{evalfill}{HTML}{F3E8FF}\n\n\\begin{document}\n\\resizebox{\\columnwidth}{!}{%\n\\begin{tikzpicture}[\n  font=\\small,\n  base/.style={\n    rounded corners=2pt,\n    line width=0.6pt,\n    align=center,\n    inner sep=3pt\n  },\n  inputbox/.style={base, draw=inputblue, fill=inputfill, text width=2.1cm},\n  targetbox/.style={base, draw=targetgreen, fill=targetfill, text width=2.3cm},\n  baselinebox/.style={base, draw=baselinegray, fill=baselinefill, text width=2.3cm},\n  residualbox/.style={base, draw=resorange, fill=resfill, text width=2.3cm},\n  meanbox/.style={base, draw=amberdark, fill=amberfill, line width=1.2pt,\n                  text width=2.6cm},\n  corrbox/.style={base, draw=targetgreen, fill=targetfill, text width=2.3cm,\n                 minimum height=1.05cm},\n  evalbox/.style={base, draw=evalpurple, fill=evalfill, text width=2.45cm,\n                  inner ysep=4pt, dash pattern=on 3pt off 2pt,\n                  font=\\footnotesize, minimum height=1.05cm},\n  arr/.style={-{Stealth[length=2.4mm]}, line width=0.7pt, draw=slategray},\n  amberarr/.style={-{Stealth[length=2.8mm]}, line width=1.2pt, draw=amberdark},\n  grayarr/.style={-{Stealth[length=2.4mm]}, line width=0.7pt,\n                  draw=baselinegray, dashed},\n  note/.style={font=\\fontsize{7.5}{9}\\selectfont, align=left}\n]\n\n% ------------------------------------------------------------------ nodes\n\\node[inputbox] (input) at (1.25,5.0)\n  {$x_i,\\ i=1,\\dots,5$\\\\[1pt]{\\footnotesize $x=(-2,-1,0,1,2)$}};\n\n\\node[targetbox] (target) at (4.6,5.0)\n  {$y_i = 2x_i + 3$\\\\[1pt]{\\footnotesize $(-1,1,3,5,7)$}};\n\n\\node[baselinebox] (baseline) at (1.25,3.05)\n  {{\\footnotesize Fixed predictor}\\\\[1pt]$\\hat{y}_i^{(0)} = 2x_i$\\\\[1pt]\n   {\\footnotesize $(-4,-2,0,2,4)$}};\n\n\\node[residualbox] (residual) at (4.6,3.05)\n  {$r_i = y_i - 2x_i$\\\\[1pt]{\\footnotesize $(3,3,3,3,3)$}};\n\n\\node[meanbox] (mean) at (4.6,1.1)\n  {$b = \\frac{1}{5}\\sum_{i=1}^{5} r_i = 3$};\n\n\\node[corrbox] (corr) at (7.9,1.1)\n  {$\\hat{y}_i = 2x_i + b$\\\\[1pt]{\\footnotesize $(-1,1,3,5,7)$}};\n\n\\node[evalbox] (eval) at (11.2,1.1)\n  {Evaluate $\\hat{y}_i$ against $y_i$\\\\on the same five $(x_i, y_i)$};\n\n% ------------------------------------------------------------------ edges\n% input -> baseline\n\\draw[arr] (input.south) -- (baseline.north)\n  node[midway, right=2pt] {$\\times 2$};\n\n% target -> residual\n\\draw[arr] (target.south) -- (residual.north)\n  node[midway, right=2pt] {$+y_i$};\n\n% baseline -> residual\n\\draw[arr] (baseline.east) -- (residual.west)\n  node[midway, above] {$-2x_i$};\n\n% residual -> mean (emphasized amber dependency)\n\\draw[amberarr] (residual.south) -- (mean.north);\n\\node[note, anchor=west]\n  at ([xshift=3pt]$(residual.south)!0.5!(mean.north)$)\n  {mean over the\\\\observed residuals};\n\n% mean -> corrected (additive correction)\n\\draw[arr] (mean.east) -- (corr.west)\n  node[midway, above] {$+\\,b$};\n\n% corrected -> evaluation\n\\draw[arr] (corr.east) -- (eval.west)\n  node[midway, above] {$\\hat{y}_i$};\n\n% baseline feed: drop, run along lower margin, rise into corrected\n\\coordinate (feedlevel) at (0,-0.55);\n\\draw[arr] (baseline.south) -- (baseline.south |- feedlevel)\n  -- (corr.south |- feedlevel) -- (corr.south);\n\\node[font=\\small, below=3pt]\n  at ($(baseline.south |- feedlevel)!0.5!(corr.south |- feedlevel)$)\n  {$2x_i$};\n\n% target -> evaluation (dashed gray elbow, high channel, vertical drop)\n\\draw[grayarr] (target.east) -| (eval.north);\n\\node[font=\\small, anchor=west]\n  at ([xshift=2pt]$(target.east -| eval.north)!0.5!(eval.north)$)\n  {$y_i$};\n\n% reuse callout, strictly below the evaluation node\n\\node[font=\\fontsize{7.5}{9}\\selectfont, align=center, text width=3.2cm,\n      anchor=north] at ([yshift=-9pt]eval.south)\n  {\\hyphenpenalty=10000 Same five observations used\\\\to estimate $b$ and to score.};\n\n\\end{tikzpicture}%\n}\n\\end{document}\n```"