"```latex\n\\documentclass[tikz,border=5pt]{standalone}\n\\usepackage{amsmath}\n\\usetikzlibrary{arrows.meta}\n\n\\definecolor{inFill}{HTML}{DCE9F7}\n\\definecolor{inLine}{HTML}{2563EB}\n\\definecolor{grFill}{HTML}{DCFCE7}\n\\definecolor{grLine}{HTML}{15803D}\n\\definecolor{gyFill}{HTML}{F3F4F6}\n\\definecolor{gyLine}{HTML}{6B7280}\n\\definecolor{orFill}{HTML}{FFEDD5}\n\\definecolor{orLine}{HTML}{C2410C}\n\\definecolor{amFill}{HTML}{FEF3C7}\n\\definecolor{amLine}{HTML}{B45309}\n\\definecolor{lvFill}{HTML}{F3E8FF}\n\\definecolor{lvLine}{HTML}{7E22CE}\n\\definecolor{slate}{HTML}{374151}\n\n\\begin{document}\n\\begin{tikzpicture}[\n  font=\\small,\n  box/.style={rounded corners=2pt, line width=0.6pt, align=center, inner sep=4pt},\n  arr/.style={draw=slate, line width=0.7pt, -{Stealth}},\n  note/.style={align=center, font=\\fontsize{7.5}{9}\\selectfont}\n]\n\n% ---------------- Nodes ----------------\n\\node[box, fill=inFill, draw=inLine] (input) at (0,7.0)\n  {$x_i,\\ i=1,\\dots,5$\\\\[1pt] $x=(-2,-1,0,1,2)$};\n\n\\node[box, fill=grFill, draw=grLine] (target) at (4.1,7.0)\n  {$y_i = 2x_i + 3$\\\\[1pt] $(-1,\\,1,\\,3,\\,5,\\,7)$};\n\n\\node[box, fill=gyFill, draw=gyLine] (baseline) at (0,4.3)\n  {Fixed predictor $\\hat{y}_i^{(0)} = 2x_i$\\\\[1pt] $(-4,-2,0,2,4)$};\n\n\\node[box, fill=orFill, draw=orLine] (residual) at (4.1,4.3)\n  {$r_i = y_i - 2x_i$\\\\[1pt] $(3,3,3,3,3)$};\n\n\\node[box, fill=amFill, draw=amLine, line width=1.2pt] (mean) at (4.1,1.4)\n  {$b = \\dfrac{1}{5}\\sum_{i=1}^{5} r_i = 3$};\n\n\\node[box, fill=grFill, draw=grLine] (corrected) at (8.2,1.4)\n  {$\\hat{y}_i = 2x_i + b$\\\\[1pt] $(-1,1,3,5,7)$};\n\n\\node[box, fill=lvFill, draw=lvLine, dash pattern=on 3pt off 2pt] (eval) at (12.5,1.4)\n  {Evaluate $\\hat{y}_i$ against $y_i$\\\\on the same five $(x_i, y_i)$.};\n\n% ---------------- Edges ----------------\n% Input -> Baseline\n\\draw[arr] (input.south) -- (baseline.north)\n  node[midway, right] {$\\times 2$};\n\n% Target -> Residual (top anchor)\n\\draw[arr] (target.south) -- (residual.north)\n  node[midway, right] {$+\\,y_i$};\n\n% Baseline -> Residual (left anchor)\n\\draw[arr] (baseline.east) -- (residual.west)\n  node[midway, above] {$-\\,2x_i$};\n\n% Residual -> Mean residual (emphasized amber dependency)\n\\draw[draw=amLine, line width=1.2pt, -{Stealth}] (residual.south) -- (mean.north)\n  node[midway, right, note, inner sep=2.5pt] {mean over the\\\\observed residuals};\n\n% Mean -> Corrected (additive correction)\n\\draw[arr] (mean.east) -- (corrected.west)\n  node[midway, above] {$+\\,b$};\n\n% Baseline feed: drop, run below Row 3, rise into corrected prediction\n\\draw[arr] (baseline.south) -- (0,0.1) -- (8.2,0.1) -- (corrected.south)\n  node[pos=0.62, below] {$2x_i$};\n\n% Corrected -> Evaluation\n\\draw[arr] (corrected.east) -- (eval.west)\n  node[midway, above] {$\\hat{y}_i$};\n\n% Target -> Evaluation (dashed gray elbow along upper margin)\n\\draw[draw=gyLine, line width=0.7pt, dashed, -{Stealth}]\n  (target.east) -- ++(0.55,0) -- ++(0,-1.4) -- (12.5,5.6) -- (eval.north)\n  node[pos=0.86, right] {$y_i$};\n\n% Reuse callout beneath the evaluation node\n\\node[note] at (12.5,0.5) {Same five observations used\\\\to estimate $b$ and to score.};\n\n\\end{tikzpicture}\n\\end{document}\n```"